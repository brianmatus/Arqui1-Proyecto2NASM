   908                                  ;Prints number passed in stack to buffer set at SI
   909                                  NumberToString:		;SI: buffer to output. Stack(2) passed in pop order: number, symbol.
   910 0000044F 678B442402              	mov AX, [ESP+2]
   911 00000454 B90000                  	mov CX, 0x0						;for counting chars pushed
   912                                  
   913 00000457 3D0000                  	cmp AX, 0						;Special case: number is 0
   914 0000045A 7507                    	jne NumberToString_not_zero
   915 0000045C C60430                  	mov [SI], byte 0x30				;Adds 0, goto exit
   916 0000045F 46                      	inc SI
   917 00000460 E94100                  	jmp NumberToString_normal_exit
   918                                  
   919                                  	NumberToString_not_zero:
   920                                  
   921 00000463 678B542404              	mov DX, [ESP+4]					;Get number sign from stack
   922 00000468 81FA0000                	cmp DX, 0						;Its positive?
   923 0000046C 7404                    	je NumberToString_not_negative
   924 0000046E C6042D                  	mov [SI], byte 0x2d				;If not, add - to string buffer
   925 00000471 46                      	inc SI
   926                                  
   927                                  	NumberToString_not_negative:	;Clean DX for divisions
   928 00000472 31D2                    	xor DX, DX
   929                                  
   930                                  	NumberToString_reverse_loop:
   931 00000474 3D0000                  		cmp AX, 0					;Have we reached 0 as base number?
   932 00000477 7411                    		je NumberToString_exit1
   933 00000479 BB0A00                  		mov BX, 10					;Prepare divider
   934 0000047C F7F3                    		div BX						;DL contains remainder
   935 0000047E 81C23000                		add DX, '0'					;Make it ascii
   936 00000482 52                      		push DX						;Store it for later
   937 00000483 31D2                    		xor DX, DX					;Clean DX for net division
   938 00000485 83C101                  		add CX, byte 0x1			;++ chars pushed
   939 00000488 EBEA                    		jmp NumberToString_reverse_loop
   940                                  
   941                                  
   942                                  	NumberToString_exit1:
   943                                  		NumberToString_normal_loop:
   944 0000048A 81F90000                		cmp CX, 0					;Are chars still un stack?
   945 0000048E 7414                    		je NumberToString_normal_exit
   946 00000490 678B0424                		mov AX, [ESP]				;Get it
   947 00000494 8904                    		mov [SI], AX				;Add it to buffer
   948 00000496 46                      		inc SI
   949 00000497 81E90100                		sub CX, 1					;--charsInStack
   950 0000049B 6681C402000000          		add ESP, 2					;Clean stack
   951 000004A2 EBE6                    		jmp NumberToString_normal_loop
   952                                  
   953                                  	NumberToString_normal_exit:
   954 000004A4 C7040000                		mov [SI], word 0			;null-terminate buffer
   955 000004A8 46                      		inc SI
   956 000004A9 C60424                  		mov [SI], byte 0x24 		;$ for printing int21hs compliance
   957 000004AC C3                      		ret
