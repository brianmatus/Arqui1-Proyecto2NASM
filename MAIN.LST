    20                              <1> %macro MACRO_PRINT_CHAR 1
    21                              <1> 	xor DX, DX
    22                              <1> 	mov AH, 0x6 			; Print String
    23                              <1> 	mov DL, %1	; Start address of message
    24                              <1> 	int 0x21
    25                              <1> %endmacro
    26                              <1> 
    27                              <1> 
    28                              <1> %macro MACRO_PRINT_STRING 1
    29                              <1> 	mov AH, 0x9 			; Print String
    30                              <1> 	mov DX, %1	; Start address of message
    31                              <1> 	int 0x21
    32                              <1> %endmacro
    33                              <1> 
    34                              <1> 
    35                              <1> %macro MACRO_PARSE_STRING_BUFFER 1
    36                              <1> 	mov SI, %1		;Parameter for Parse String
    37                              <1> 	call ParseString
    38                              <1> %endmacro
    39                              <1> 
