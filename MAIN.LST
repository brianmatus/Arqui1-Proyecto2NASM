   924                                  ;Prints number passed in stack to buffer set at SI
   925                                  NumberToString:		;SI: buffer to output. Stack(2) passed in pop order: number, symbol.
   926 00001031 678B442402              	mov AX, [ESP+2]
   927 00001036 B90000                  	mov CX, 0x0						;for counting chars pushed
   928                                  
   929 00001039 83F800                  	cmp AX, 0						;Special case: number is 0
   930 0000103C 7506                    	jne NumberToString_not_zero
   931 0000103E C60430                  	mov [SI], byte 0x30				;Adds 0, goto exit
   932 00001041 46                      	inc SI
   933 00001042 EB3A                    	jmp NumberToString_normal_exit
   934                                  
   935                                  	NumberToString_not_zero:
   936                                  
   937 00001044 678B542404              	mov DX, [ESP+4]					;Get number sign from stack
   938 00001049 83FA00                  	cmp DX, 0						;Its positive?
   939 0000104C 7404                    	je NumberToString_not_negative
   940 0000104E C6042D                  	mov [SI], byte 0x2d				;If not, add - to string buffer
   941 00001051 46                      	inc SI
   942                                  
   943                                  	NumberToString_not_negative:	;Clean DX for divisions
   944 00001052 31D2                    	xor DX, DX
   945                                  
   946                                  	NumberToString_reverse_loop:
   947 00001054 83F800                  		cmp AX, 0					;Have we reached 0 as base number?
   948 00001057 7410                    		je NumberToString_exit1
   949 00001059 BB0A00                  		mov BX, 10					;Prepare divider
   950 0000105C F7F3                    		div BX						;DL contains remainder
   951 0000105E 83C230                  		add DX, '0'					;Make it ascii
   952 00001061 52                      		push DX						;Store it for later
   953 00001062 31D2                    		xor DX, DX					;Clean DX for net division
   954 00001064 83C101                  		add CX, byte 0x1			;charsInStack++
   955 00001067 EBEB                    		jmp NumberToString_reverse_loop
   956                                  
   957                                  
   958                                  	NumberToString_exit1:
   959                                  		NumberToString_normal_loop:
   960 00001069 83F900                  		cmp CX, 0					;Are chars still un stack?
   961 0000106C 7410                    		je NumberToString_normal_exit
   962 0000106E 678B0424                		mov AX, [ESP]				;Get it
   963 00001072 8904                    		mov [SI], AX				;Add it to buffer
   964 00001074 46                      		inc SI
   965 00001075 83E901                  		sub CX, 1					;charsInStack--
   966 00001078 6683C402                		add ESP, 2					;Clean stack
   967 0000107C EBEB                    		jmp NumberToString_normal_loop
