    42                              <1> %macro MACRO_ENTER_COEFFICIENT 1
    43                              <1> 	EnterFunctionCoefficients_coef_%1:
    44                              <1> 	MACRO_PRINT_STRING enter_coef_%1			;Promt to enter respective coefficient
    45                              <1> 	call ReadUntilLN							;Read input
    46                              <1> 	MACRO_PARSE_STRING_BUFFER inStrBuf			;Parse the number
    47                              <1> 
    48                              <1> 	push AX										;save entered number
    49                              <1> 	mov AH, 0x9
    50                              <1> 	mov DX, text_ln_r							;print newline
    51                              <1> 	int 0x21
    52                              <1> 	pop AX										;Restore entered number
    53                              <1> 
    54                              <1> 	cmp CX, 0x1									;Was there an error?
    55                              <1> 	jne EnterFunctionCoefficients_coef_%1_ok
    56                              <1> 	MACRO_PRINT_STRING input_error_2			;Tell user to try again
    57                              <1> 	jmp EnterFunctionCoefficients_coef_%1
    58                              <1> 	EnterFunctionCoefficients_coef_%1_ok:
    59                              <1> 	mov [coef_%1], AX							;Save entered coefficient
    60                              <1> 	mov [coef_%1_sign], BX						;save coefficient sign
    61                              <1> %endmacro
    62                              <1> 
    63                              <1> 
    64                              <1> %macro MACRO_PARSE_NUMBER_WITHOUT_SIGN_TO_STRING 1
    65                              <1> 	mov SI, word gen_output_buff				;Set the buffer where the parsed number will be
    66                              <1> 	push word 0x0								;+ as sign
    67                              <1> 	push word %1								;number to be parsed
    68                              <1> 	call NumberToString
    69                              <1> 	add ESP, 4									;Restore stack
    70                              <1> %endmacro
    71                              <1> 
    72                              <1> 
    73                              <1> 
    74                              <1> %macro MACRO_PRINT_FUNC_COEF 1
    75                              <1> 	cmp [coef_%1_sign], byte 0					;Compare Sign
    76                              <1> 	je m_print_func_coef_%1_pos
    77                              <1> 	MACRO_PRINT_CHAR 0x2d						;If neg, print -
    78                              <1> 	jmp m_print_func_coef_%1_number
    79                              <1> 
    80                              <1> 	m_print_func_coef_%1_pos:
    81                              <1> 	MACRO_PRINT_CHAR 0x2b						;If pos, print +
    82                              <1> 
    83                              <1> 	m_print_func_coef_%1_number:
    84                              <1> 	MACRO_PARSE_NUMBER_WITHOUT_SIGN_TO_STRING [coef_%1]
    85                              <1> 	MACRO_PRINT_STRING gen_output_buff
    86                              <1> 	MACRO_PRINT_STRING str_x_%1
    87                              <1> %endmacro
    88                              <1> %macro MACRO_PRINT_DERIV_COEF 2
    89                              <1> 	cmp [coef_%1_sign], byte 0			;Compare Sign
    90                              <1> 	je m_print_deriv_coef_%1_pos
    91                              <1> 	MACRO_PRINT_CHAR 0x2d				;If neg, print -
    92                              <1> 	jmp m_print_deriv_coef_%1_number
    93                              <1> 
    94                              <1> 	m_print_deriv_coef_%1_pos:
    95                              <1> 	MACRO_PRINT_CHAR 0x2b				;If pos, print +
    96                              <1> 
    97                              <1> 	m_print_deriv_coef_%1_number:
    98                              <1> 	MACRO_PARSE_NUMBER_WITHOUT_SIGN_TO_STRING [coef_%1_d]
    99                              <1> 	MACRO_PRINT_STRING gen_output_buff
   100                              <1> 	MACRO_PRINT_STRING str_x_%2
   101                              <1> %endmacro
   102                              <1> 
   103                              <1> %macro MACRO_PRINT_INT_COEF 2
   104                              <1> 	cmp [coef_%1_sign], byte 0			;Compare Sign
   105                              <1> 	je m_print_int_coef_%1_pos
   106                              <1> 	MACRO_PRINT_CHAR 0x2d				;If neg, print -
   107                              <1> 	jmp m_print_int_coef_%1_number
   108                              <1> 
   109                              <1> 	m_print_int_coef_%1_pos:
   110                              <1> 	MACRO_PRINT_CHAR 0x2b				;If pos, print +
   111                              <1> 
   112                              <1> 	m_print_int_coef_%1_number:
   113                              <1> 	MACRO_PARSE_NUMBER_WITHOUT_SIGN_TO_STRING [coef_%1_i_num]
   114                              <1> 	MACRO_PRINT_STRING gen_output_buff
   115                              <1> 	cmp [coef_%1_i_den], word 1			;If denominator is 1, skip '/' + denominator
   116                              <1> 	je m_print_int_coef_%1_den_is_1
   117                              <1> 
   118                              <1> 	MACRO_PRINT_CHAR 0x2f				; /
   119                              <1> 	MACRO_PARSE_NUMBER_WITHOUT_SIGN_TO_STRING [coef_%1_i_den]
   120                              <1> 	MACRO_PRINT_STRING gen_output_buff
   121                              <1> 
   122                              <1> 	m_print_int_coef_%1_den_is_1:
   123                              <1> 	MACRO_PRINT_STRING str_x_%2
   124                              <1> %endmacro
