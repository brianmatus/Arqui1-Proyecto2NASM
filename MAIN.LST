   271                              <1> ;ONE TIME USE
   272                              <1> %macro MACRO_ASK_X0 0
   273                              <1> 	GraphFunction_enter_xo:
   274                              <1> 		MACRO_PRINT_STRING str_enter_xo				;Promt to enter xo
   275                              <1> 		call ReadUntilLN							;Read input
   276                              <1> 		MACRO_PRINT_STRING text_ln_r
   277                              <1> 		MACRO_PARSE_STRING_BUFFER inStrBuf			;Parse the number
   278                              <1> 
   279                              <1> 		cmp CX, word 0x1							;If no error
   280                              <1> 		jne GraphFunction_xo_correct				;then continue
   281                              <1> 		MACRO_PRINT_STRING input_error_2			;print user error
   282                              <1> 		jmp GraphFunction_enter_xo					;retry
   283                              <1> 
   284                              <1> 	GraphFunction_xo_correct:
   285                              <1> 	cmp BX, word 0x0								;if negative
   286                              <1> 	je GraphFunction_xo_positive
   287                              <1> 	neg AX											;invert sign
   288                              <1> 	GraphFunction_xo_positive:
   289                              <1> 	mov [graph_xo], AX								;store it
   290                              <1> 
   291                              <1> %endmacro
   292                              <1> 
   293                              <1> 
   294                              <1> ;ONE TIME USE
   295                              <1> %macro MACRO_ASK_XF 0
   296                              <1> 	GraphFunction_enter_xf:
   297                              <1> 		MACRO_PRINT_STRING str_enter_xf			;Promt to enter xf
   298                              <1> 		call ReadUntilLN						;Read input
   299                              <1> 		MACRO_PRINT_STRING text_ln_r
   300                              <1> 		MACRO_PARSE_STRING_BUFFER inStrBuf		;Parse the number
   301                              <1> 
   302                              <1> 		cmp CX, word 0x1						;If no error
   303                              <1> 		jne GraphFunction_xf_correct			;then continue
   304                              <1> 		MACRO_PRINT_STRING input_error_2		;print user error
   305                              <1> 		jmp GraphFunction_enter_xo				;retry to xo in case of mind change
   306                              <1> 
   307                              <1> 	GraphFunction_xf_correct:
   308                              <1> 	cmp BX, word 0x0							;if negative
   309                              <1> 	je GraphFunction_xf_positive
   310                              <1> 	neg AX										;invert sign
   311                              <1> 	GraphFunction_xf_positive:
   312                              <1> 	mov [graph_xf], AX							;store it
   313                              <1> 	cmp AX, [graph_xo]							;If Xf-Xo
   314                              <1> 	jg GraphFunction_interval_correct			;continue
   315                              <1> 	MACRO_PRINT_STRING input_error_3			;else, tell user
   316                              <1> 	jmp GraphFunction_enter_xo					;and try again
   317                              <1> 
   318                              <1> 	GraphFunction_interval_correct:
   319                              <1> 
   320                              <1> %endmacro
   321                              <1> 
   322                              <1> 
   323                              <1> ;ONE TIME USE
   324                              <1> %macro MACRO_ASK_Y_RANGE 0
   325                              <1> 	GraphFunction_enter_y_range:
   326                              <1> 		MACRO_PRINT_STRING str_enter_y_range	;Promt to enter Y range
   327                              <1> 		call ReadUntilLN						;Read input
   328                              <1> 		MACRO_PRINT_STRING text_ln_r
   329                              <1> 		MACRO_PARSE_STRING_BUFFER inStrBuf		;Parse the number
   330                              <1> 
   331                              <1> 		cmp CX, word 0x1						;If no error
   332                              <1> 		jne GraphFunction_y_range_correct		;then continue
   333                              <1> 		MACRO_PRINT_STRING input_error_2		;print user error
   334                              <1> 		jmp GraphFunction_enter_y_range			;retry
   335                              <1> 
   336                              <1> 		GraphFunction_y_range_correct:
   337                              <1> 		cmp BX, word 0x0						;Y interval is not entered with -
   338                              <1> 		je GraphFunction_y_range_positive
   339                              <1> 		MACRO_PRINT_STRING input_error_3		;print user error
   340                              <1> 		jmp GraphFunction_enter_y_range
   341                              <1> 
   342                              <1> 	GraphFunction_y_range_positive:
   343                              <1> 	mov [graph_y_size], AX
   344                              <1> %endmacro
   345                              <1> 
   346                              <1> %macro MACRO_SCROLL_UP_BY 1
   347                              <1> 	pusha
   348                              <1> 	mov AH, 0x6    ; set function to scroll page up
   349                              <1> 	mov AL, %1
   350                              <1> 	mov BH, 0
   351                              <1> 	mov CH, 0x0
   352                              <1> 	mov CL, 0x0
   353                              <1> 	mov DH, 29
   354                              <1> 	mov DL, 79
   355                              <1> 	int 10h        ; call BIOS interrupt to scroll page
   356                              <1> 	popa
   357                              <1> %endmacro
   358                              <1> 
   359                              <1> 
   360                              <1> %macro MACRO_SET_CURSOR_AT 2
   361                              <1> 	pusha
   362                              <1> 	mov AH, 0x2		;Set Cursor Position
   363                              <1> 	mov BH, 0x0		;Page 0 (only one in graphics mode)
   364                              <1> 	mov DH, %1		;Row
   365                              <1> 	mov DL, %2		;Column
   366                              <1> 	int 0x10
   367                              <1> 	popa
   368                              <1> %endmacro
