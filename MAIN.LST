  1155                                  ;Prints number passed in stack to buffer set at SI
  1156                                  NumberToString:		;SI: buffer to output. Stack(2) passed in pop order: number, symbol.
  1157 000005FC 678B442402              	mov AX, [ESP+2]
  1158 00000601 B90000                  	mov CX, 0x0						;for counting chars pushed
  1159                                  
  1160 00000604 3D0000                  	cmp AX, 0						;Special case: number is 0
  1161 00000607 7507                    	jne NumberToString_not_zero
  1162 00000609 C60430                  	mov [SI], byte 0x30				;Adds 0, goto exit
  1163 0000060C 46                      	inc SI
  1164 0000060D E94100                  	jmp NumberToString_normal_exit
  1165                                  
  1166                                  	NumberToString_not_zero:
  1167                                  
  1168 00000610 678B542404              	mov DX, [ESP+4]					;Get number sign from stack
  1169 00000615 81FA0000                	cmp DX, 0						;Its positive?
  1170 00000619 7404                    	je NumberToString_not_negative
  1171 0000061B C6042D                  	mov [SI], byte 0x2d				;If not, add - to string buffer
  1172 0000061E 46                      	inc SI
  1173                                  
  1174                                  	NumberToString_not_negative:	;Clean DX for divisions
  1175 0000061F 31D2                    	xor DX, DX
  1176                                  
  1177                                  	NumberToString_reverse_loop:
  1178 00000621 3D0000                  		cmp AX, 0					;Have we reached 0 as base number?
  1179 00000624 7411                    		je NumberToString_exit1
  1180 00000626 BB0A00                  		mov BX, 10					;Prepare divider
  1181 00000629 F7F3                    		div BX						;DL contains remainder
  1182 0000062B 81C23000                		add DX, '0'					;Make it ascii
  1183 0000062F 52                      		push DX						;Store it for later
  1184 00000630 31D2                    		xor DX, DX					;Clean DX for net division
  1185 00000632 83C101                  		add CX, byte 0x1			;charsInStack++
  1186 00000635 EBEA                    		jmp NumberToString_reverse_loop
  1187                                  
  1188                                  
  1189                                  	NumberToString_exit1:
  1190                                  		NumberToString_normal_loop:
  1191 00000637 81F90000                		cmp CX, 0					;Are chars still un stack?
  1192 0000063B 7414                    		je NumberToString_normal_exit
  1193 0000063D 678B0424                		mov AX, [ESP]				;Get it
  1194 00000641 8904                    		mov [SI], AX				;Add it to buffer
  1195 00000643 46                      		inc SI
  1196 00000644 81E90100                		sub CX, 1					;charsInStack--
  1197 00000648 6681C402000000          		add ESP, 2					;Clean stack
  1198 0000064F EBE6                    		jmp NumberToString_normal_loop
  1199                                  
