   345                                  ParseString:	;[SI] as pointer,   returns: AX: result BX: sign  CX:return code
   346 0000012A 31C0                        xor ax, ax ; clear ax
   347 0000012C 31DB                        xor bx, bx ; clear bx
   348 0000012E 31C9                        xor cx, cx ; clear cx
   349                                  
   350 00000130 BF0A00                      mov di, 10 ; set the base to 10
   351                                  
   352                                  	;TODO checar primer caracter por un signo
   353                                  
   354 00000133 8A1C                    	mov bl, [SI] ; load the current character into bl
   355                                  
   356 00000135 81FB2B00                	cmp bx, '+'
   357 00000139 7504                    	jne ParseString_check_minus
   358 0000013B 46                      	inc si ; move to the next character
   359 0000013C E90D00                  	jmp ParseString_is_positive
   360                                  
   361                                  	ParseString_check_minus:
   362 0000013F 81FB2D00                	cmp bx, '-'
   363 00000143 7507                    	jne ParseString_is_positive
   364 00000145 680100                  	push 0x1	;Flag as negative
   365 00000148 46                      	inc si 		; move to the next character
   366                                  
   367 00000149 E90300                  	jmp parse_loop
   368                                  
   369                                  	ParseString_is_positive:
   370 0000014C 680000                  	push 0x0	;Flag as possitive
   371                                  
   372                                  	parse_loop:
   373 0000014F 8A1C                        mov bl, [SI] ; load the current character into al
   374 00000151 46                          inc si ; move to the next character
   375                                  
   376 00000152 80FB00                      cmp bl, 0x0 		;have we reached the end of the number?
   377 00000155 7416                        je  parse_done
   378                                  
   379 00000157 81FB3000                	cmp bx, '0'			;Is this not a number char? (lower half)
   380 0000015B 7C15                    	jl parse_error
   381 0000015D 81FB3900                	cmp bx, '9'			;Is this not a number char? (upper half)
   382 00000161 7F0F                    	jg parse_error
   383                                  
   384 00000163 81EB3000                    sub bx, '0' 		; subtract the ASCII value of '0' to get the actual numeric value
   385 00000167 F7E7                        mul di		 		; multiply the current result by the base (10)
   386 00000169 01D8                        add ax, bx 			; add the digit to the result
   387                                  
   388 0000016B EBE2                        jmp parse_loop ; continue parsing the next character
   389                                  
   390                                  	parse_done:
   391 0000016D B90000                  	mov CX, 0			;Exit code 0 for success, 1 for input error
   392 00000170 5B                      	pop BX
   393                                  ;	cmp BX, 0
   394                                  ;	je ParseString_not_negative_result
   395                                  ;	neg AX
   396                                  ;	ParseString_not_negative_result
   397 00000171 C3                          ret
   398                                  
   399                                      parse_error:
   400 00000172 B90100                      mov CX, 1
   401                                  ;    pop BX
   402 00000175 6681C402000000          	add esp, 2
   403 0000017C C3                          ret
   404                                  
   405                                  
