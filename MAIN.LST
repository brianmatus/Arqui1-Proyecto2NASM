   619 00000C9B 31C0                        xor ax, ax 	; Clean needed registers
   620 00000C9D 31DB                        xor bx, bx 	;
   621 00000C9F 31C9                        xor cx, cx 	;
   622                                  
   623 00000CA1 BF0A00                      mov di, 10 ; set the base to 10
   624                                  
   625 00000CA4 8A1C                    	mov bl, [SI] ; load the current character into bl
   626                                  
   627 00000CA6 83FB2B                  	cmp bx, '+'
   628 00000CA9 7503                    	jne ParseString_check_minus
   629 00000CAB 46                      	inc si ; move to the next character
   630 00000CAC EB0A                    	jmp ParseString_is_positive
