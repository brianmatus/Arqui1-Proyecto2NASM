   682 00000259 31C0                        xor ax, ax 	; Clean needed registers
   683 0000025B 31DB                        xor bx, bx 	;
   684 0000025D 31C9                        xor cx, cx 	;
   685                                  
   686 0000025F BF0A00                      mov di, 10 ; set the base to 10
   687                                  
   688                                  	;TODO checar primer caracter por un signo
   689                                  
   690 00000262 8A1C                    	mov bl, [SI] ; load the current character into bl
   691                                  
   692 00000264 81FB2B00                	cmp bx, '+'
   693 00000268 7504                    	jne ParseString_check_minus
   694 0000026A 46                      	inc si ; move to the next character
   695 0000026B E90D00                  	jmp ParseString_is_positive
   696                                  
   697                                  	ParseString_check_minus:
   698 0000026E 81FB2D00                	cmp bx, '-'
   699 00000272 7507                    	jne ParseString_is_positive
   700 00000274 680100                  	push 0x1	;Flag as negative
   701 00000277 46                      	inc si 		; move to the next character
   702                                  
   703 00000278 E90300                  	jmp parse_loop
   704                                  
   705                                  	ParseString_is_positive:
   706 0000027B 680000                  	push 0x0	;Flag as possitive
   707                                  
   708                                  	parse_loop:
   709 0000027E 8A1C                        mov bl, [SI] ; load the current character into al
   710 00000280 46                          inc si ; move to the next character
   711                                  
   712 00000281 80FB00                      cmp bl, 0x0 		;have we reached the end of the number?
   713 00000284 7416                        je  parse_done
   714                                  
   715 00000286 81FB3000                	cmp bx, '0'			;Is this not a number char? (lower half)
   716 0000028A 7C15                    	jl parse_error
   717 0000028C 81FB3900                	cmp bx, '9'			;Is this not a number char? (upper half)
   718 00000290 7F0F                    	jg parse_error
   719                                  
   720 00000292 81EB3000                    sub bx, '0' 		; subtract the ASCII value of '0' to get the actual numeric value
   721 00000296 F7E7                        mul di		 		; multiply the current result by the base (10)
   722 00000298 01D8                        add ax, bx 			; add the digit to the result
   723                                  
   724 0000029A EBE2                        jmp parse_loop ; continue parsing the next character
   725                                  
   726                                  	parse_done:
   727 0000029C B90000                  	mov CX, 0			;Exit code 0 for success, 1 for input error
   728 0000029F 5B                      	pop BX
   729                                  ;	cmp BX, 0
   730                                  ;	je ParseString_not_negative_result
   731                                  ;	neg AX
   732                                  ;	ParseString_not_negative_result
   733 000002A0 C3                          ret
   734                                  
   735                                      parse_error:
   736 000002A1 B90100                      mov CX, 1
   737                                  ;    pop BX
   738 000002A4 6681C402000000          	add esp, 2
   739 000002AB C3                          ret
