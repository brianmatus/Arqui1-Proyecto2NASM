    10                              <1> %macro MACRO_PRINT_STRING 1
    11                              <1> 	mov AH, 0x9 			; Print String
    12                              <1> 	mov DX, %1	; Start address of message
    13                              <1> 	int 0x21
    14                              <1> %endmacro
    15                              <1> 
    16                              <1> 
    17                              <1> %macro MACRO_PARSE_STRING_BUFFER 1
