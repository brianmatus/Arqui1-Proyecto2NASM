   696 00000A5A 31C0                        xor ax, ax 	; Clean needed registers
   697 00000A5C 31DB                        xor bx, bx 	;
   698 00000A5E 31C9                        xor cx, cx 	;
   699                                  
   700 00000A60 BF0A00                      mov di, 10 ; set the base to 10
   701                                  
   702 00000A63 8A1C                    	mov bl, [SI] ; load the current character into bl
   703                                  
   704 00000A65 83FB2B                  	cmp bx, '+'
   705 00000A68 7503                    	jne ParseString_check_minus
   706 00000A6A 46                      	inc si ; move to the next character
   707 00000A6B EB0A                    	jmp ParseString_is_positive
   708                                  
   709                                  	ParseString_check_minus:
   710 00000A6D 83FB2D                  	cmp bx, '-'
   711 00000A70 7505                    	jne ParseString_is_positive
   712 00000A72 6A01                    	push 0x1	;Flag as negative
   713 00000A74 46                      	inc si 		; move to the next character
   714                                  
   715 00000A75 EB02                    	jmp parse_loop
   716                                  
   717                                  	ParseString_is_positive:
   718 00000A77 6A00                    	push 0x0	;Flag as possitive
   719                                  
   720                                  	parse_loop:
   721 00000A79 8A1C                        mov bl, [SI] ; load the current character into al
   722 00000A7B 46                          inc si ; move to the next character
   723                                  
   724 00000A7C 80FB00                      cmp bl, 0x0 		;have we reached the end of the number?
   725 00000A7F 7413                        je  parse_done
   726                                  
   727 00000A81 83FB30                  	cmp bx, '0'			;Is this not a number char? (lower half)
   728 00000A84 7C13                    	jl parse_error
   729 00000A86 83FB39                  	cmp bx, '9'			;Is this not a number char? (upper half)
   730 00000A89 7F0E                    	jg parse_error
   731                                  
   732 00000A8B 83EB30                      sub bx, '0' 		; subtract the ASCII value of '0' to get the actual numeric value
   733 00000A8E F7E7                        mul di		 		; multiply the current result by the base (10)
   734 00000A90 01D8                        add ax, bx 			; add the digit to the result
   735                                  
   736 00000A92 EBE5                        jmp parse_loop ; continue parsing the next character
   737                                  
   738                                  	parse_done:
   739 00000A94 B90000                  	mov CX, 0			;Exit code 0 for success, 1 for input error
