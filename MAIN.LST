   617 00000C7B 31C0                        xor ax, ax 	; Clean needed registers
   618 00000C7D 31DB                        xor bx, bx 	;
   619 00000C7F 31C9                        xor cx, cx 	;
   620                                  
   621 00000C81 BF0A00                      mov di, 10 ; set the base to 10
   622                                  
   623 00000C84 8A1C                    	mov bl, [SI] ; load the current character into bl
   624                                  
   625 00000C86 83FB2B                  	cmp bx, '+'
   626 00000C89 7503                    	jne ParseString_check_minus
   627 00000C8B 46                      	inc si ; move to the next character
   628 00000C8C EB0A                    	jmp ParseString_is_positive
   629                                  
   630                                  	ParseString_check_minus:
   631 00000C8E 83FB2D                  	cmp bx, '-'
   632 00000C91 7505                    	jne ParseString_is_positive
   633 00000C93 6A01                    	push 0x1	;Flag as negative
   634 00000C95 46                      	inc si 		; move to the next character
   635                                  
   636 00000C96 EB02                    	jmp parse_loop
   637                                  
   638                                  	ParseString_is_positive:
   639 00000C98 6A00                    	push 0x0	;Flag as possitive
   640                                  
   641                                  	parse_loop:
   642 00000C9A 8A1C                        mov bl, [SI] ; load the current character into al
   643 00000C9C 46                          inc si ; move to the next character
   644                                  
   645 00000C9D 80FB00                      cmp bl, 0x0 		;have we reached the end of the number?
   646 00000CA0 7413                        je  parse_done
   647                                  
   648 00000CA2 83FB30                  	cmp bx, '0'			;Is this not a number char? (lower half)
   649 00000CA5 7C13                    	jl parse_error
   650 00000CA7 83FB39                  	cmp bx, '9'			;Is this not a number char? (upper half)
   651 00000CAA 7F0E                    	jg parse_error
   652                                  
   653 00000CAC 83EB30                      sub bx, '0' 		; subtract the ASCII value of '0' to get the actual numeric value
   654 00000CAF F7E7                        mul di		 		; multiply the current result by the base (10)
   655 00000CB1 01D8                        add ax, bx 			; add the digit to the result
   656                                  
   657 00000CB3 EBE5                        jmp parse_loop ; continue parsing the next character
   658                                  
   659                                  	parse_done:
   660 00000CB5 B90000                  	mov CX, 0			;Exit code 0 for success, 1 for input error
   661 00000CB8 5B                      	pop BX
   662                                  ;	cmp BX, 0
   663                                  ;	je ParseString_not_negative_result
   664                                  ;	neg AX
   665                                  ;	ParseString_not_negative_result
   666 00000CB9 C3                          ret
