   356                                  ParseString:	;[SI] as pointer,   returns: AX: result BX: sign  CX:return code
   357 00000741 31C0                        xor ax, ax 	; Clean needed registers
   358 00000743 31DB                        xor bx, bx 	;
   359 00000745 31C9                        xor cx, cx 	;
   360                                  
   361 00000747 BF0A00                      mov di, 10 ; set the base to 10
   362                                  
   363 0000074A 8A1C                    	mov bl, [SI] ; load the current character into bl
   364                                  
   365 0000074C 83FB2B                  	cmp bx, '+'
   366 0000074F 7503                    	jne ParseString_check_minus
   367 00000751 46                      	inc si ; move to the next character
   368 00000752 EB0A                    	jmp ParseString_is_positive
   369                                  
   370                                  	ParseString_check_minus:
   371 00000754 83FB2D                  	cmp bx, '-'
   372 00000757 7505                    	jne ParseString_is_positive
   373 00000759 6A01                    	push 0x1	;Flag as negative
   374 0000075B 46                      	inc si 		; move to the next character
   375                                  
   376 0000075C EB02                    	jmp parse_loop
   377                                  
   378                                  	ParseString_is_positive:
   379 0000075E 6A00                    	push 0x0	;Flag as possitive
   380                                  
   381                                  	parse_loop:
   382 00000760 8A1C                        mov bl, [SI] ; load the current character into al
   383 00000762 46                          inc si ; move to the next character
   384                                  
   385 00000763 80FB00                      cmp bl, 0x0 		;have we reached the end of the number?
   386 00000766 7413                        je  parse_done
   387                                  
   388 00000768 83FB30                  	cmp bx, '0'			;Is this not a number char? (lower half)
   389 0000076B 7C13                    	jl parse_error
   390 0000076D 83FB39                  	cmp bx, '9'			;Is this not a number char? (upper half)
   391 00000770 7F0E                    	jg parse_error
   392                                  
   393 00000772 83EB30                      sub bx, '0' 		; subtract the ASCII value of '0' to get the actual numeric value
   394 00000775 F7E7                        mul di		 		; multiply the current result by the base (10)
   395 00000777 01D8                        add ax, bx 			; add the digit to the result
   396                                  
   397 00000779 EBE5                        jmp parse_loop ; continue parsing the next character
   398                                  
   399                                  	parse_done:
   400 0000077B B90000                  	mov CX, 0			;Exit code 0 for success, 1 for input error
   401 0000077E 5B                      	pop BX
   402                                  ;	cmp BX, 0
   403                                  ;	je ParseString_not_negative_result
   404                                  ;	neg AX
   405                                  ;	ParseString_not_negative_result
   406 0000077F C3                          ret
   407                                  
   408                                      parse_error:
   409 00000780 B90100                      mov CX, 1
   410                                  ;    pop BX
   411 00000783 6683C402                	add esp, 2
   412 00000787 C3                          ret
   413                                  
