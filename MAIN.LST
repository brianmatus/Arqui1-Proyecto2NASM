   990                                  
   991 00000F9B 3C0D                    	cmp AL, 0xD				;Compare to \r
   992 00000F9D 7412                    	je ReadUntilLN_done
   993                                  
   994 00000F9F 8B3E[ED00]              	mov DI, [inStrBuf_p]		;Put char pointer in DI
   995 00000FA3 8805                    	mov [DI], AL				;Set value to the read char
   996 00000FA5 FE06[ED00]              	inc byte [inStrBuf_p]		;Increment pointer
   997                                  
