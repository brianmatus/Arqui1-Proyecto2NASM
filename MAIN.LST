   415                                  ReadUntilLN:
   416                                  
   417 00000788 BF[8F00]                	mov DI, inStrBuf		;Put start of str ptr into inStrBuf_p
   418 0000078B 893E[8D00]              	mov [inStrBuf_p], DI
   419                                  
   420                                  	ReadUntilLN_loop:
   421 0000078F B408                    	mov AH, 0x8		;User input without echo
   422 00000791 CD21                    	int 0x21		;DOS Function Dispatcher
   423                                  
   424 00000793 3C0D                    	cmp AL, 0xD				;Compare to \r
   425 00000795 7412                    	je ReadUntilLN_done
   426                                  
   427 00000797 8B3E[8D00]              	mov DI, [inStrBuf_p]		;Put char pointer in DI
   428 0000079B 8805                    	mov [DI], AL				;Set value to the read char
   429 0000079D FE06[8D00]              	inc byte [inStrBuf_p]		;Increment pointer
   430                                  
   431                                  	;Feedback entered char to user
   432 000007A1 B406                    	mov AH, 0x6		;Direct I/O
   433 000007A3 88C2                    	mov DL, AL		;
   434 000007A5 CD21                    	int 0x21
   435 000007A7 EBE6                    	jmp ReadUntilLN_loop
   436                                  
   437                                  	ReadUntilLN_done:
   438 000007A9 8B3E[8D00]              	mov DI, [inStrBuf_p]
   439 000007AD C60500                  	mov byte [DI], 0x0		;null-terminate string
   440 000007B0 47                      	inc DI
   441 000007B1 C60524                  	mov byte [DI], 0x24		;add $ for printing
   442 000007B4 C3                      	ret
