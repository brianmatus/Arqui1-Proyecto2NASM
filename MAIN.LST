   523                                  ParseString:	;[SI] as pointer,   returns: AX: result BX: sign  CX:return code
   524 00000925 31C0                        xor ax, ax 	; Clean needed registers
   525 00000927 31DB                        xor bx, bx 	;
   526 00000929 31C9                        xor cx, cx 	;
   527                                  
   528 0000092B BF0A00                      mov di, 10 ; set the base to 10
   529                                  
   530 0000092E 8A1C                    	mov bl, [SI] ; load the current character into bl
   531                                  
   532 00000930 83FB2B                  	cmp bx, '+'
   533 00000933 7503                    	jne ParseString_check_minus
   534 00000935 46                      	inc si ; move to the next character
   535 00000936 EB0A                    	jmp ParseString_is_positive
   536                                  
   537                                  	ParseString_check_minus:
   538 00000938 83FB2D                  	cmp bx, '-'
   539 0000093B 7505                    	jne ParseString_is_positive
   540 0000093D 6A01                    	push 0x1	;Flag as negative
   541 0000093F 46                      	inc si 		; move to the next character
   542                                  
   543 00000940 EB02                    	jmp parse_loop
   544                                  
   545                                  	ParseString_is_positive:
   546 00000942 6A00                    	push 0x0	;Flag as possitive
   547                                  
   548                                  	parse_loop:
   549 00000944 8A1C                        mov bl, [SI] ; load the current character into al
   550 00000946 46                          inc si ; move to the next character
   551                                  
   552 00000947 80FB00                      cmp bl, 0x0 		;have we reached the end of the number?
   553 0000094A 7413                        je  parse_done
   554                                  
   555 0000094C 83FB30                  	cmp bx, '0'			;Is this not a number char? (lower half)
   556 0000094F 7C13                    	jl parse_error
   557 00000951 83FB39                  	cmp bx, '9'			;Is this not a number char? (upper half)
   558 00000954 7F0E                    	jg parse_error
   559                                  
   560 00000956 83EB30                      sub bx, '0' 		; subtract the ASCII value of '0' to get the actual numeric value
   561 00000959 F7E7                        mul di		 		; multiply the current result by the base (10)
   562 0000095B 01D8                        add ax, bx 			; add the digit to the result
   563                                  
   564 0000095D EBE5                        jmp parse_loop ; continue parsing the next character
   565                                  
   566                                  	parse_done:
   567 0000095F B90000                  	mov CX, 0			;Exit code 0 for success, 1 for input error
   568 00000962 5B                      	pop BX
   569                                  ;	cmp BX, 0
   570                                  ;	je ParseString_not_negative_result
   571                                  ;	neg AX
   572                                  ;	ParseString_not_negative_result
   573 00000963 C3                          ret
   574                                  
   575                                      parse_error:
   576 00000964 B90100                      mov CX, 1
   577                                  ;    pop BX
   578 00000967 6683C402                	add esp, 2
   579 0000096B C3                          ret
