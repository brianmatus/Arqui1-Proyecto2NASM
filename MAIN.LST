   422                                  
   423                                  	;TODO checar primer caracter por un signo
   424                                  
   425 0000012A 8A1C                    	mov bl, [SI] ; load the current character into bl
   426                                  
   427 0000012C 81FB2B00                	cmp bx, '+'
   428 00000130 7504                    	jne ParseString_check_minus
   429 00000132 46                      	inc si ; move to the next character
