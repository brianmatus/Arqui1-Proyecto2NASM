    35                              <1> 	jmp EnterFunctionCoefficients_coef_%1
    36                              <1> 	EnterFunctionCoefficients_coef_%1_ok:
    37                              <1> 	mov [coef_%1], AX
    38                              <1> 	mov [coef_%1_sign], BX
    39                              <1> %endmacro
