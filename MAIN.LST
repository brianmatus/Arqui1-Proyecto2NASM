  1689                                  ;Prints number passed in stack to buffer set at SI
  1690                                  NumberToString:		;SI: buffer to output. Stack(2) passed in pop order: number, symbol.
  1691 00000995 678B442402              	mov AX, [ESP+2]
  1692 0000099A B90000                  	mov CX, 0x0						;for counting chars pushed
  1693                                  
  1694 0000099D 3D0000                  	cmp AX, 0						;Special case: number is 0
  1695 000009A0 7507                    	jne NumberToString_not_zero
  1696 000009A2 C60430                  	mov [SI], byte 0x30				;Adds 0, goto exit
  1697 000009A5 46                      	inc SI
  1698 000009A6 E94100                  	jmp NumberToString_normal_exit
  1699                                  
  1700                                  	NumberToString_not_zero:
  1701                                  
  1702 000009A9 678B542404              	mov DX, [ESP+4]					;Get number sign from stack
  1703 000009AE 81FA0000                	cmp DX, 0						;Its positive?
  1704 000009B2 7404                    	je NumberToString_not_negative
  1705 000009B4 C6042D                  	mov [SI], byte 0x2d				;If not, add - to string buffer
  1706 000009B7 46                      	inc SI
  1707                                  
  1708                                  	NumberToString_not_negative:	;Clean DX for divisions
  1709 000009B8 31D2                    	xor DX, DX
  1710                                  
  1711                                  	NumberToString_reverse_loop:
  1712 000009BA 3D0000                  		cmp AX, 0					;Have we reached 0 as base number?
  1713 000009BD 7411                    		je NumberToString_exit1
  1714 000009BF BB0A00                  		mov BX, 10					;Prepare divider
  1715 000009C2 F7F3                    		div BX						;DL contains remainder
  1716 000009C4 81C23000                		add DX, '0'					;Make it ascii
  1717 000009C8 52                      		push DX						;Store it for later
  1718 000009C9 31D2                    		xor DX, DX					;Clean DX for net division
  1719 000009CB 83C101                  		add CX, byte 0x1			;charsInStack++
  1720 000009CE EBEA                    		jmp NumberToString_reverse_loop
  1721                                  
  1722                                  
  1723                                  	NumberToString_exit1:
  1724                                  		NumberToString_normal_loop:
  1725 000009D0 81F90000                		cmp CX, 0					;Are chars still un stack?
  1726 000009D4 7414                    		je NumberToString_normal_exit
  1727 000009D6 678B0424                		mov AX, [ESP]				;Get it
  1728 000009DA 8904                    		mov [SI], AX				;Add it to buffer
  1729 000009DC 46                      		inc SI
