   104                              <1> %macro MACRO_UPDATE_DERIVATIVE_COEF 1
   105                              <1> 	xor DX, DX
   106                              <1> 	mov AX, [coef_%1]
   107                              <1> 	mov BX, %1
   108                              <1> 	mul BX
   109                              <1> 	mov [coef_%1_d], AX
   110                              <1> %endmacro
