   678                                  ParseString:	;[SI] as pointer,   returns: AX: result BX: sign  CX:return code
   679 00000DA7 31C0                        xor ax, ax 	; Clean needed registers
   680 00000DA9 31DB                        xor bx, bx 	;
   681 00000DAB 31C9                        xor cx, cx 	;
   682                                  
   683 00000DAD BF0A00                      mov di, 10 ; set the base to 10
   684                                  
   685 00000DB0 8A1C                    	mov bl, [SI] ; load the current character into bl
   686                                  
   687 00000DB2 83FB2B                  	cmp bx, '+'
   688 00000DB5 7503                    	jne ParseString_check_minus
   689 00000DB7 46                      	inc si ; move to the next character
   690 00000DB8 EB0A                    	jmp ParseString_is_positive
   691                                  
   692                                  	ParseString_check_minus:
   693 00000DBA 83FB2D                  	cmp bx, '-'
   694 00000DBD 7505                    	jne ParseString_is_positive
   695 00000DBF 6A01                    	push 0x1	;Flag as negative
   696 00000DC1 46                      	inc si 		; move to the next character
   697                                  
   698 00000DC2 EB02                    	jmp parse_loop
   699                                  
   700                                  	ParseString_is_positive:
   701 00000DC4 6A00                    	push 0x0	;Flag as possitive
   702                                  
   703                                  	parse_loop:
   704 00000DC6 8A1C                        mov bl, [SI] ; load the current character into al
   705 00000DC8 46                          inc si ; move to the next character
   706                                  
   707 00000DC9 80FB00                      cmp bl, 0x0 		;have we reached the end of the number?
   708 00000DCC 7413                        je  parse_done
   709                                  
   710 00000DCE 83FB30                  	cmp bx, '0'			;Is this not a number char? (lower half)
   711 00000DD1 7C13                    	jl parse_error
   712 00000DD3 83FB39                  	cmp bx, '9'			;Is this not a number char? (upper half)
   713 00000DD6 7F0E                    	jg parse_error
   714                                  
   715 00000DD8 83EB30                      sub bx, '0' 		; subtract the ASCII value of '0' to get the actual numeric value
   716 00000DDB F7E7                        mul di		 		; multiply the current result by the base (10)
   717 00000DDD 01D8                        add ax, bx 			; add the digit to the result
   718                                  
   719 00000DDF EBE5                        jmp parse_loop ; continue parsing the next character
   720                                  
   721                                  	parse_done:
   722 00000DE1 B90000                  	mov CX, 0			;Exit code 0 for success, 1 for input error
   723 00000DE4 5B                      	pop BX
   724                                  ;	cmp BX, 0
   725                                  ;	je ParseString_not_negative_result
