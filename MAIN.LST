   758                                  ParseString:	;[SI] as pointer,   returns: AX: result BX: sign  CX:return code
   759 00000B72 31C0                        xor ax, ax 	; Clean needed registers
   760 00000B74 31DB                        xor bx, bx 	;
   761 00000B76 31C9                        xor cx, cx 	;
   762                                  
   763 00000B78 BF0A00                      mov di, 10 ; set the base to 10
   764 00000B7B 8A1C                    	mov bl, [SI] ; load the current character into bl
   765 00000B7D 83FB2B                  	cmp bx, '+'
   766 00000B80 7503                    	jne ParseString_check_minus
   767 00000B82 46                      	inc si ; move to the next character
   768 00000B83 EB0A                    	jmp ParseString_is_positive
   769                                  
   770                                  	ParseString_check_minus:
   771 00000B85 83FB2D                  	cmp bx, '-'
   772 00000B88 7505                    	jne ParseString_is_positive
   773 00000B8A 6A01                    	push 0x1	;Flag as negative
   774 00000B8C 46                      	inc si 		; move to the next character
   775 00000B8D EB02                    	jmp parse_loop
   776                                  
   777                                  	ParseString_is_positive:
   778 00000B8F 6A00                    	push 0x0	;Flag as possitive
   779                                  
   780                                  	parse_loop:
   781 00000B91 8A1C                        mov bl, [SI] ; load the current character into al
   782 00000B93 46                          inc si ; move to the next character
   783                                  
   784 00000B94 80FB00                      cmp bl, 0x0 		;have we reached the end of the number?
   785 00000B97 7413                        je  parse_done
   786                                  
   787 00000B99 83FB30                  	cmp bx, '0'			;Is this not a number char? (lower half)
   788 00000B9C 7C13                    	jl parse_error
   789 00000B9E 83FB39                  	cmp bx, '9'			;Is this not a number char? (upper half)
   790 00000BA1 7F0E                    	jg parse_error
   791                                  
   792 00000BA3 83EB30                      sub bx, '0' 		; subtract the ASCII value of '0' to get the actual numeric value
   793 00000BA6 F7E7                        mul di		 		; multiply the current result by the base (10)
