   834 00000EB5 31D2                    		xor DX, DX					;clean for division
   835 00000EB7 F7F3                    		div BX
   836 00000EB9 89D8                    		mov AX, BX					;x=y
   837 00000EBB 89D3                    		mov BX, DX					;y=remainder
   838 00000EBD EBF1                    		jmp MaxCommonDivisor_loop	;repeat
