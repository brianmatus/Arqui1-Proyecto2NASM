   587                                  	ReadUntilLN_loop:
   588 00000973 B408                    	mov AH, 0x8		;User input without echo
   589 00000975 CD21                    	int 0x21		;DOS Function Dispatcher
   590                                  
   591 00000977 3C0D                    	cmp AL, 0xD				;Compare to \r
   592 00000979 7412                    	je ReadUntilLN_done
   593                                  
   594 0000097B 8B3E[9600]              	mov DI, [inStrBuf_p]		;Put char pointer in DI
   595 0000097F 8805                    	mov [DI], AL				;Set value to the read char
   596 00000981 FE06[9600]              	inc byte [inStrBuf_p]		;Increment pointer
   597                                  
