   632                                  	ParseString_check_minus:
   633 00000CAE 83FB2D                  	cmp bx, '-'
   634 00000CB1 7505                    	jne ParseString_is_positive
   635 00000CB3 6A01                    	push 0x1	;Flag as negative
   636 00000CB5 46                      	inc si 		; move to the next character
   637                                  
   638 00000CB6 EB02                    	jmp parse_loop
   639                                  
   640                                  	ParseString_is_positive:
   641 00000CB8 6A00                    	push 0x0	;Flag as possitive
   642                                  
   643                                  	parse_loop:
   644 00000CBA 8A1C                        mov bl, [SI] ; load the current character into al
   645 00000CBC 46                          inc si ; move to the next character
   646                                  
   647 00000CBD 80FB00                      cmp bl, 0x0 		;have we reached the end of the number?
   648 00000CC0 7413                        je  parse_done
   649                                  
   650 00000CC2 83FB30                  	cmp bx, '0'			;Is this not a number char? (lower half)
   651 00000CC5 7C13                    	jl parse_error
   652 00000CC7 83FB39                  	cmp bx, '9'			;Is this not a number char? (upper half)
   653 00000CCA 7F0E                    	jg parse_error
   654                                  
   655 00000CCC 83EB30                      sub bx, '0' 		; subtract the ASCII value of '0' to get the actual numeric value
   656 00000CCF F7E7                        mul di		 		; multiply the current result by the base (10)
   657 00000CD1 01D8                        add ax, bx 			; add the digit to the result
   658                                  
   659 00000CD3 EBE5                        jmp parse_loop ; continue parsing the next character
   660                                  
   661                                  	parse_done:
   662 00000CD5 B90000                  	mov CX, 0			;Exit code 0 for success, 1 for input error
   663 00000CD8 5B                      	pop BX
