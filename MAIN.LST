     1                                  %include "code/macros.asm"
     2                              <1> %macro CLEARSCREEN 0
     3                              <1> 	;Video BIOS
     4                              <1> 	mov AH, 0x0		;Set video mode
     5                              <1> 	mov AL, 0x12	;640x480 16 color graphics (VGA)
     6                              <1> 	int 0x10
     7                              <1> %endmacro
     8                              <1> 
     9                              <1> 
    10                              <1> 
    11                              <1> %macro MACRO_INPUT_CHAR_NO_ECO 0
    12                              <1> 	mov AH, 0x8		;User input without echo
    13                              <1> 	int 0x21		;DOS Function Dispatcher
    14                              <1> %endmacro
    15                              <1> 
    16                              <1> 
    17                              <1> %macro MACRO_PRINT_CHAR 1
    18                              <1> 	xor DX, Dx
    19                              <1> 	mov AH, 0x6 			; Print String
    20                              <1> 	mov DL, %1	; Start address of message
    21                              <1> 	int 0x21
    22                              <1> %endmacro
    23                              <1> 
    24                              <1> 
    25                              <1> %macro MACRO_PRINT_STRING 1
    26                              <1> 	mov AH, 0x9 			; Print String
    27                              <1> 	mov DX, %1	; Start address of message
    28                              <1> 	int 0x21
    29                              <1> %endmacro
    30                              <1> 
    31                              <1> 
    32                              <1> %macro MACRO_PARSE_STRING_BUFFER 1
    33                              <1> 	mov SI, %1		;Parameter for Parse String
    34                              <1> 	call ParseString
    35                              <1> %endmacro
    36                              <1> 
    37                              <1> 
    38                              <1> 
    39                              <1> %macro MACRO_ENTER_COEFFICIENT 1
    40                              <1> 	EnterFunctionCoefficients_coef_%1:
    41                              <1> 	MACRO_PRINT_STRING enter_coef_%1			;Promt to enter respective coefficient
    42                              <1> 	call ReadUntilLN							;Read input
    43                              <1> 	MACRO_PARSE_STRING_BUFFER inStrBuf			;Parse the number
    44                              <1> 
    45                              <1> 	push AX										;save entered number
    46                              <1> 	mov AH, 0x9
    47                              <1> 	mov DX, text_ln_r							;print newline
    48                              <1> 	int 0x21
    49                              <1> 	pop AX										;Restore entered number
    50                              <1> 
    51                              <1> 	cmp CX, 0x1									;Was there an error?
    52                              <1> 	jne EnterFunctionCoefficients_coef_%1_ok
    53                              <1> 	MACRO_PRINT_STRING input_error_2			;Tell user to try again
    54                              <1> 	jmp EnterFunctionCoefficients_coef_%1
    55                              <1> 	EnterFunctionCoefficients_coef_%1_ok:
    56                              <1> 	mov [coef_%1], AX							;Save entered coefficient
    57                              <1> 	mov [coef_%1_sign], BX						;save coefficient sign
    58                              <1> %endmacro
    59                              <1> 
    60                              <1> 
    61                              <1> %macro MACRO_PARSE_NUMBER_WITHOUT_SIGN_TO_STRING 1
    62                              <1> 	mov SI, word gen_output_buff				;Set the buffer where the parsed number will be
    63                              <1> 	push word 0x0								;+ as sign
    64                              <1> 	push word %1								;number to be parsed
    65                              <1> 	call NumberToString
    66                              <1> 	add ESP, 4									;Restore stack
    67                              <1> %endmacro
    68                              <1> 
    69                              <1> 
    70                              <1> 
    71                              <1> %macro MACRO_PRINT_FUNC_COEF 1
    72                              <1> 	cmp [coef_%1_sign], byte 0			;Compare Sign
    73                              <1> 	je m_print_func_coef_%1_pos
    74                              <1> 	MACRO_PRINT_CHAR 0x2d				;If neg, print -
    75                              <1> 	jmp m_print_func_coef_%1_number
    76                              <1> 
    77                              <1> 	m_print_func_coef_%1_pos:
    78                              <1> 	MACRO_PRINT_CHAR 0x2b				;If pos, print +
    79                              <1> 
    80                              <1> 	m_print_func_coef_%1_number:
    81                              <1> 	MACRO_PARSE_NUMBER_WITHOUT_SIGN_TO_STRING [coef_%1]
    82                              <1> 	MACRO_PRINT_STRING gen_output_buff
    83                              <1> 	MACRO_PRINT_STRING str_x_%1
    84                              <1> %endmacro
    85                              <1> %macro MACRO_PRINT_DERIV_COEF 2
    86                              <1> 	cmp [coef_%1_sign], byte 0			;Compare Sign
    87                              <1> 	je m_print_deriv_coef_%1_pos
    88                              <1> 	MACRO_PRINT_CHAR 0x2d				;If neg, print -
    89                              <1> 	jmp m_print_deriv_coef_%1_number
    90                              <1> 
    91                              <1> 	m_print_deriv_coef_%1_pos:
    92                              <1> 	MACRO_PRINT_CHAR 0x2b				;If pos, print +
    93                              <1> 
    94                              <1> 	m_print_deriv_coef_%1_number:
    95                              <1> 	MACRO_PARSE_NUMBER_WITHOUT_SIGN_TO_STRING [coef_%1_d]
    96                              <1> 	MACRO_PRINT_STRING gen_output_buff
    97                              <1> 	MACRO_PRINT_STRING str_x_%2
    98                              <1> %endmacro
    99                              <1> 
   100                              <1> 
