   443                                  	parse_loop:
   444 00000146 8A1C                        mov bl, [SI] ; load the current character into al
   445 00000148 46                          inc si ; move to the next character
   446                                  
   447 00000149 80FB00                      cmp bl, 0x0 		;have we reached the end of the number?
   448 0000014C 7416                        je  parse_done
   449                                  
   450 0000014E 81FB3000                	cmp bx, '0'			;Is this not a number char? (lower half)
   451 00000152 7C15                    	jl parse_error
   452 00000154 81FB3900                	cmp bx, '9'			;Is this not a number char? (upper half)
   453 00000158 7F0F                    	jg parse_error
   454                                  
   455 0000015A 81EB3000                    sub bx, '0' 		; subtract the ASCII value of '0' to get the actual numeric value
   456 0000015E F7E7                        mul di		 		; multiply the current result by the base (10)
   457 00000160 01D8                        add ax, bx 			; add the digit to the result
   458                                  
   459 00000162 EBE2                        jmp parse_loop ; continue parsing the next character
   460                                  
   461                                  	parse_done:
   462 00000164 B90000                  	mov CX, 0			;Exit code 0 for success, 1 for input error
   463 00000167 5B                      	pop BX
