   758                                  ;Prints number passed in stack to buffer set at SI
   759                                  NumberToString:		;SI: buffer to output. Stack(2) passed in pop order: number, symbol.
   760 00000E4E 678B442402              	mov AX, [ESP+2]
   761 00000E53 B90000                  	mov CX, 0x0						;for counting chars pushed
   762                                  
   763 00000E56 83F800                  	cmp AX, 0						;Special case: number is 0
   764 00000E59 7506                    	jne NumberToString_not_zero
   765 00000E5B C60430                  	mov [SI], byte 0x30				;Adds 0, goto exit
   766 00000E5E 46                      	inc SI
   767 00000E5F EB3A                    	jmp NumberToString_normal_exit
   768                                  
   769                                  	NumberToString_not_zero:
   770                                  
   771 00000E61 678B542404              	mov DX, [ESP+4]					;Get number sign from stack
   772 00000E66 83FA00                  	cmp DX, 0						;Its positive?
   773 00000E69 7404                    	je NumberToString_not_negative
   774 00000E6B C6042D                  	mov [SI], byte 0x2d				;If not, add - to string buffer
   775 00000E6E 46                      	inc SI
   776                                  
   777                                  	NumberToString_not_negative:	;Clean DX for divisions
   778 00000E6F 31D2                    	xor DX, DX
   779                                  
   780                                  	NumberToString_reverse_loop:
   781 00000E71 83F800                  		cmp AX, 0					;Have we reached 0 as base number?
   782 00000E74 7410                    		je NumberToString_exit1
   783 00000E76 BB0A00                  		mov BX, 10					;Prepare divider
   784 00000E79 F7F3                    		div BX						;DL contains remainder
   785 00000E7B 83C230                  		add DX, '0'					;Make it ascii
   786 00000E7E 52                      		push DX						;Store it for later
   787 00000E7F 31D2                    		xor DX, DX					;Clean DX for net division
   788 00000E81 83C101                  		add CX, byte 0x1			;charsInStack++
   789 00000E84 EBEB                    		jmp NumberToString_reverse_loop
   790                                  
   791                                  
   792                                  	NumberToString_exit1:
   793                                  		NumberToString_normal_loop:
   794 00000E86 83F900                  		cmp CX, 0					;Are chars still un stack?
   795 00000E89 7410                    		je NumberToString_normal_exit
   796 00000E8B 678B0424                		mov AX, [ESP]				;Get it
   797 00000E8F 8904                    		mov [SI], AX				;Add it to buffer
   798 00000E91 46                      		inc SI
   799 00000E92 83E901                  		sub CX, 1					;charsInStack--
   800 00000E95 6683C402                		add ESP, 2					;Clean stack
   801 00000E99 EBEB                    		jmp NumberToString_normal_loop
   802                                  
   803                                  	NumberToString_normal_exit:
   804                                  ;		mov [SI], word 0			;null-terminate buffer
   805                                  ;		inc SI
