     1                                  ;Al inicio de este proyecto, dios y yo sabíamos que estaba haciendo.
     2                                  ;Ahora, sólo dios sabe xD
     3                                  %include "code/macros.asm"
     4                              <1> %macro CLEARSCREEN 0
     5                              <1> 	;Video BIOS
     6                              <1> 	mov AH, 0x0		;Set video mode
     7                              <1> 	mov AL, 0x12	;640x480 16 color graphics (VGA)
     8                              <1> 	int 0x10
     9                              <1> %endmacro
    10                              <1> 
    11                              <1> 
    12                              <1> 
    13                              <1> %macro MACRO_INPUT_CHAR_NO_ECO 0
    14                              <1> 	mov AH, 0x8		;User input without echo
    15                              <1> 	int 0x21		;DOS Function Dispatcher
    16                              <1> %endmacro
    17                              <1> 
    18                              <1> 
    19                              <1> %macro MACRO_PRINT_CHAR 1
    20                              <1> 	xor DX, Dx
    21                              <1> 	mov AH, 0x6 			; Print String
    22                              <1> 	mov DL, %1	; Start address of message
    23                              <1> 	int 0x21
    24                              <1> %endmacro
    25                              <1> 
    26                              <1> 
    27                              <1> %macro MACRO_PRINT_STRING 1
    28                              <1> 	mov AH, 0x9 			; Print String
    29                              <1> 	mov DX, %1	; Start address of message
    30                              <1> 	int 0x21
    31                              <1> %endmacro
    32                              <1> 
    33                              <1> 
    34                              <1> %macro MACRO_PARSE_STRING_BUFFER 1
    35                              <1> 	mov SI, %1		;Parameter for Parse String
    36                              <1> 	call ParseString
    37                              <1> %endmacro
    38                              <1> 
    39                              <1> 
    40                              <1> 
    41                              <1> %macro MACRO_ENTER_COEFFICIENT 1
    42                              <1> 	EnterFunctionCoefficients_coef_%1:
    43                              <1> 	MACRO_PRINT_STRING enter_coef_%1			;Promt to enter respective coefficient
    44                              <1> 	call ReadUntilLN							;Read input
    45                              <1> 	MACRO_PARSE_STRING_BUFFER inStrBuf			;Parse the number
    46                              <1> 
    47                              <1> 	push AX										;save entered number
    48                              <1> 	mov AH, 0x9
    49                              <1> 	mov DX, text_ln_r							;print newline
    50                              <1> 	int 0x21
    51                              <1> 	pop AX										;Restore entered number
    52                              <1> 
    53                              <1> 	cmp CX, 0x1									;Was there an error?
    54                              <1> 	jne EnterFunctionCoefficients_coef_%1_ok
    55                              <1> 	MACRO_PRINT_STRING input_error_2			;Tell user to try again
    56                              <1> 	jmp EnterFunctionCoefficients_coef_%1
    57                              <1> 	EnterFunctionCoefficients_coef_%1_ok:
    58                              <1> 	mov [coef_%1], AX							;Save entered coefficient
    59                              <1> 	mov [coef_%1_sign], BX						;save coefficient sign
    60                              <1> %endmacro
    61                              <1> 
    62                              <1> 
    63                              <1> %macro MACRO_PARSE_NUMBER_WITHOUT_SIGN_TO_STRING 1
    64                              <1> 	mov SI, word gen_output_buff				;Set the buffer where the parsed number will be
    65                              <1> 	push word 0x0								;+ as sign
    66                              <1> 	push word %1								;number to be parsed
    67                              <1> 	call NumberToString
    68                              <1> 	add ESP, 4									;Restore stack
    69                              <1> %endmacro
    70                              <1> 
    71                              <1> 
    72                              <1> 
    73                              <1> %macro MACRO_PRINT_FUNC_COEF 1
    74                              <1> 	cmp [coef_%1_sign], byte 0			;Compare Sign
    75                              <1> 	je m_print_func_coef_%1_pos
    76                              <1> 	MACRO_PRINT_CHAR 0x2d				;If neg, print -
    77                              <1> 	jmp m_print_func_coef_%1_number
    78                              <1> 
    79                              <1> 	m_print_func_coef_%1_pos:
    80                              <1> 	MACRO_PRINT_CHAR 0x2b				;If pos, print +
    81                              <1> 
    82                              <1> 	m_print_func_coef_%1_number:
    83                              <1> 	MACRO_PARSE_NUMBER_WITHOUT_SIGN_TO_STRING [coef_%1]
    84                              <1> 	MACRO_PRINT_STRING gen_output_buff
    85                              <1> 	MACRO_PRINT_STRING str_x_%1
    86                              <1> %endmacro
    87                              <1> %macro MACRO_PRINT_DERIV_COEF 2
    88                              <1> 	cmp [coef_%1_sign], byte 0			;Compare Sign
    89                              <1> 	je m_print_deriv_coef_%1_pos
    90                              <1> 	MACRO_PRINT_CHAR 0x2d				;If neg, print -
    91                              <1> 	jmp m_print_deriv_coef_%1_number
    92                              <1> 
    93                              <1> 	m_print_deriv_coef_%1_pos:
    94                              <1> 	MACRO_PRINT_CHAR 0x2b				;If pos, print +
    95                              <1> 
    96                              <1> 	m_print_deriv_coef_%1_number:
    97                              <1> 	MACRO_PARSE_NUMBER_WITHOUT_SIGN_TO_STRING [coef_%1_d]
    98                              <1> 	MACRO_PRINT_STRING gen_output_buff
    99                              <1> 	MACRO_PRINT_STRING str_x_%2
   100                              <1> %endmacro
   101                              <1> 
   102                              <1> %macro MACRO_PRINT_INT_COEF 2
   103                              <1> 	cmp [coef_%1_sign], byte 0			;Compare Sign
   104                              <1> 	je m_print_int_coef_%1_pos
   105                              <1> 	MACRO_PRINT_CHAR 0x2d				;If neg, print -
   106                              <1> 	jmp m_print_int_coef_%1_number
   107                              <1> 
   108                              <1> 	m_print_int_coef_%1_pos:
   109                              <1> 	MACRO_PRINT_CHAR 0x2b				;If pos, print +
   110                              <1> 
   111                              <1> 	m_print_int_coef_%1_number:
   112                              <1> 	MACRO_PARSE_NUMBER_WITHOUT_SIGN_TO_STRING [coef_%1_i_num]
   113                              <1> 	MACRO_PRINT_STRING gen_output_buff
   114                              <1> 	cmp [coef_%1_i_den], word 1			;If denominator is 1, skip '/' + denominator
   115                              <1> 	je m_print_int_coef_%1_den_is_1
   116                              <1> 
   117                              <1> 	MACRO_PRINT_CHAR 0x2f				; /
   118                              <1> 	MACRO_PARSE_NUMBER_WITHOUT_SIGN_TO_STRING [coef_%1_i_den]
   119                              <1> 	MACRO_PRINT_STRING gen_output_buff
   120                              <1> 
   121                              <1> 	m_print_int_coef_%1_den_is_1:
   122                              <1> 	MACRO_PRINT_STRING str_x_%2
   123                              <1> %endmacro
   124                              <1> 
   125                              <1> 
   126                              <1> 
   127                              <1> 
   128                              <1> %macro MACRO_UPDATE_DERIVATIVE_COEF 1
   129                              <1> 	xor DX, DX				;Clean up
   130                              <1> 	mov AX, [coef_%1]		;x
   131                              <1> 	mov BX, %1				;y
   132                              <1> 	mul BX					;x = xy
   133                              <1> 	mov [coef_%1_d], AX		;Store it
   134                              <1> %endmacro
   135                              <1> 
   136                              <1> %macro MACRO_UPDATE_INTEGRAL_COEFFICIENT 1
   137                              <1> 
   138                              <1> 	push word [coef_%1]		;Numerator
   139                              <1> 	push %1+1				;Divisor
   140                              <1> 	call MaxCommonDivisor
   141                              <1> 	add ESP, 4				;Clean stack
   142                              <1> 
   143                              <1> 	;Now that MCD is calculated, divide both numbers by it
   144                              <1> 	mov BX, AX				;Denominator
   145                              <1> 	xor DX, DX				;Clean upper part of numerator
   146                              <1> 	mov AX, [coef_%1]		;Numerator
   147                              <1> 	div BX
   148                              <1> 	mov [coef_%1_i_num], AX	;Save integral numerator
   149                              <1> 
   150                              <1> 	;BX already has max common divisor as denominator
   151                              <1> 	xor DX, DX				;Clean upper part of numerator
   152                              <1> 	mov AX, %1+1			;Numerator
   153                              <1> 	div BX
   154                              <1> 	mov [coef_%1_i_den], AX	;Save integral denominator
   155                              <1> 
   156                              <1> %endmacro
