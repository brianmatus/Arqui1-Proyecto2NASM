   923                                  ParseString:	;[SI] as pointer,   returns: AX: result BX: sign  CX:return code
   924 00000F49 31C0                        xor ax, ax 	; Clean needed registers
   925 00000F4B 31DB                        xor bx, bx 	;
   926 00000F4D 31C9                        xor cx, cx 	;
   927                                  
   928 00000F4F BF0A00                      mov di, 10 ; set the base to 10
   929                                  
   930 00000F52 8A1C                    	mov bl, [SI] ; load the current character into bl
   931                                  
   932 00000F54 83FB2B                  	cmp bx, '+'
   933 00000F57 7503                    	jne ParseString_check_minus
   934 00000F59 46                      	inc si ; move to the next character
   935 00000F5A EB0A                    	jmp ParseString_is_positive
   936                                  
   937                                  	ParseString_check_minus:
   938 00000F5C 83FB2D                  	cmp bx, '-'
   939 00000F5F 7505                    	jne ParseString_is_positive
   940 00000F61 6A01                    	push 0x1	;Flag as negative
   941 00000F63 46                      	inc si 		; move to the next character
   942                                  
   943 00000F64 EB02                    	jmp parse_loop
   944                                  
   945                                  	ParseString_is_positive:
   946 00000F66 6A00                    	push 0x0	;Flag as possitive
   947                                  
   948                                  	parse_loop:
   949 00000F68 8A1C                        mov bl, [SI] ; load the current character into al
   950 00000F6A 46                          inc si ; move to the next character
   951                                  
   952 00000F6B 80FB00                      cmp bl, 0x0 		;have we reached the end of the number?
   953 00000F6E 7413                        je  parse_done
   954                                  
   955 00000F70 83FB30                  	cmp bx, '0'			;Is this not a number char? (lower half)
   956 00000F73 7C13                    	jl parse_error
   957 00000F75 83FB39                  	cmp bx, '9'			;Is this not a number char? (upper half)
   958 00000F78 7F0E                    	jg parse_error
   959                                  
   960 00000F7A 83EB30                      sub bx, '0' 		; subtract the ASCII value of '0' to get the actual numeric value
   961 00000F7D F7E7                        mul di		 		; multiply the current result by the base (10)
   962 00000F7F 01D8                        add ax, bx 			; add the digit to the result
   963                                  
   964 00000F81 EBE5                        jmp parse_loop ; continue parsing the next character
   965                                  
   966                                  	parse_done:
   967 00000F83 B90000                  	mov CX, 0			;Exit code 0 for success, 1 for input error
   968 00000F86 5B                      	pop BX
   969                                  ;	cmp BX, 0
   970                                  ;	je ParseString_not_negative_result
   971                                  ;	neg AX
   972                                  ;	ParseString_not_negative_result
   973 00000F87 C3                          ret
   974                                  
   975                                      parse_error:
   976 00000F88 B90100                      mov CX, 1
   977                                  ;    pop BX
   978 00000F8B 6683C402                	add esp, 2
   979 00000F8F C3                          ret
