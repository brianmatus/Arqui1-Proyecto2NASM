    38                              <1> %macro MACRO_ENTER_COEFFICIENT 1
    39                              <1> 	EnterFunctionCoefficients_coef_%1:
    40                              <1> 	MACRO_PRINT_STRING enter_coef_%1			;Promt to enter respective coefficient
    41                              <1> 	call ReadUntilLN							;Read input
    42                              <1> 	MACRO_PARSE_STRING_BUFFER inStrBuf			;Parse the number
    43                              <1> 
    44                              <1> 	push AX										;save entered number
    45                              <1> 	mov AH, 0x9
    46                              <1> 	mov DX, text_ln_r							;print newline
    47                              <1> 	int 0x21
    48                              <1> 	pop AX										;Restore entered number
    49                              <1> 
    50                              <1> 	cmp CX, 0x1									;Was there an error?
    51                              <1> 	jne EnterFunctionCoefficients_coef_%1_ok
    52                              <1> 	MACRO_PRINT_STRING input_error_2			;Tell user to try again
    53                              <1> 	jmp EnterFunctionCoefficients_coef_%1
    54                              <1> 	EnterFunctionCoefficients_coef_%1_ok:
    55                              <1> 	mov [coef_%1], AX							;Save entered coefficient
    56                              <1> 	mov [coef_%1_sign], BX						;save coefficient sign
    57                              <1> %endmacro
    58                              <1> 
    59                              <1> 
    60                              <1> %macro MACRO_PARSE_NUMBER_WITHOUT_SIGN_TO_STRING 1
    61                              <1> 	mov SI, word gen_output_buff				;Set the buffer where the parsed number will be
    62                              <1> 	push word 0x0								;+ as sign
    63                              <1> 	push word %1								;number to be parsed
    64                              <1> 	call NumberToString
    65                              <1> 	add ESP, 4									;Restore stack
    66                              <1> %endmacro
    67                              <1> 
    68                              <1> 
    69                              <1> 
    70                              <1> %macro MACRO_PRINT_FUNC_COEF 1
    71                              <1> 	cmp [coef_%1_sign], byte 0					;Compare Sign
    72                              <1> 	je m_print_func_coef_%1_pos
    73                              <1> 	MACRO_PRINT_CHAR 0x2d						;If neg, print -
    74                              <1> 	jmp m_print_func_coef_%1_number
    75                              <1> 
    76                              <1> 	m_print_func_coef_%1_pos:
    77                              <1> 	MACRO_PRINT_CHAR 0x2b						;If pos, print +
    78                              <1> 
    79                              <1> 	m_print_func_coef_%1_number:
    80                              <1> 	MACRO_PARSE_NUMBER_WITHOUT_SIGN_TO_STRING [coef_%1]
    81                              <1> 	MACRO_PRINT_STRING gen_output_buff
    82                              <1> 	MACRO_PRINT_STRING str_x_%1
    83                              <1> %endmacro
    84                              <1> %macro MACRO_PRINT_DERIV_COEF 2
    85                              <1> 	cmp [coef_%1_sign], byte 0			;Compare Sign
    86                              <1> 	je m_print_deriv_coef_%1_pos
    87                              <1> 	MACRO_PRINT_CHAR 0x2d				;If neg, print -
    88                              <1> 	jmp m_print_deriv_coef_%1_number
    89                              <1> 
    90                              <1> 	m_print_deriv_coef_%1_pos:
    91                              <1> 	MACRO_PRINT_CHAR 0x2b				;If pos, print +
    92                              <1> 
    93                              <1> 	m_print_deriv_coef_%1_number:
    94                              <1> 	MACRO_PARSE_NUMBER_WITHOUT_SIGN_TO_STRING [coef_%1_d]
    95                              <1> 	MACRO_PRINT_STRING gen_output_buff
    96                              <1> 	MACRO_PRINT_STRING str_x_%2
    97                              <1> %endmacro
    98                              <1> 
    99                              <1> %macro MACRO_PRINT_INT_COEF 2
   100                              <1> 	cmp [coef_%1_sign], byte 0			;Compare Sign
   101                              <1> 	je m_print_int_coef_%1_pos
   102                              <1> 	MACRO_PRINT_CHAR 0x2d				;If neg, print -
   103                              <1> 	jmp m_print_int_coef_%1_number
   104                              <1> 
   105                              <1> 	m_print_int_coef_%1_pos:
   106                              <1> 	MACRO_PRINT_CHAR 0x2b				;If pos, print +
   107                              <1> 
   108                              <1> 	m_print_int_coef_%1_number:
   109                              <1> 	MACRO_PARSE_NUMBER_WITHOUT_SIGN_TO_STRING [coef_%1_i_num]
   110                              <1> 	MACRO_PRINT_STRING gen_output_buff
   111                              <1> 	cmp [coef_%1_i_den], word 1			;If denominator is 1, skip '/' + denominator
   112                              <1> 	je m_print_int_coef_%1_den_is_1
   113                              <1> 
   114                              <1> 	MACRO_PRINT_CHAR 0x2f				; /
   115                              <1> 	MACRO_PARSE_NUMBER_WITHOUT_SIGN_TO_STRING [coef_%1_i_den]
   116                              <1> 	MACRO_PRINT_STRING gen_output_buff
   117                              <1> 
   118                              <1> 	m_print_int_coef_%1_den_is_1:
   119                              <1> 	MACRO_PRINT_STRING str_x_%2
   120                              <1> %endmacro
   121                              <1> 
