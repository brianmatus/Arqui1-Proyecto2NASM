   407                                  
   408 0000017D BF[1E00]                	mov DI, inStrBuf		;Put start of str ptr into inStrBuf_p
   409 00000180 893E[1C00]              	mov [inStrBuf_p], DI
   410                                  
   411                                  	ReadUntilLN_loop:
   412 00000184 B408                    	mov AH, 0x8		;User input without echo
   413 00000186 CD21                    	int 0x21		;DOS Function Dispatcher
   414                                  
   415 00000188 3C0D                    	cmp AL, 0xD				;Compare to \r
