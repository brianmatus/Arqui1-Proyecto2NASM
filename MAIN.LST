   125                              <1> %macro MACRO_UPDATE_DERIVATIVE_COEF 1
   126                              <1> 	xor DX, DX				;Clean up
   127                              <1> 	mov AX, [coef_%1]		;x
   128                              <1> 	mov BX, %1				;y
   129                              <1> 	mul BX					;x = xy
   130                              <1> 	mov [coef_%1_d], AX		;Store it
   131                              <1> %endmacro
   132                              <1> 
   133                              <1> %macro MACRO_UPDATE_INTEGRAL_COEFFICIENT 1
   134                              <1> 
   135                              <1> 	push word [coef_%1]		;Numerator
   136                              <1> 	push %1+1				;Divisor
   137                              <1> 	call MaxCommonDivisor
   138                              <1> 	add ESP, 4				;Clean stack
   139                              <1> 
   140                              <1> 	;Now that MCD is calculated, divide both numbers by it
   141                              <1> 	mov BX, AX				;Denominator
   142                              <1> 	xor DX, DX				;Clean upper part of numerator
   143                              <1> 	mov AX, [coef_%1]		;Numerator
   144                              <1> 	div BX
   145                              <1> 	mov [coef_%1_i_num], AX	;Save integral numerator
   146                              <1> 
   147                              <1> 	;BX already has max common divisor as denominator
   148                              <1> 	xor DX, DX				;Clean upper part of numerator
   149                              <1> 	mov AX, %1+1			;Numerator
   150                              <1> 	div BX
   151                              <1> 	mov [coef_%1_i_den], AX	;Save integral denominator
   152                              <1> 
   153                              <1> %endmacro
   154                              <1> 
   155                              <1> %macro MACRO_FIND_FUNC_X_VALUE_OF_COEF 1
   156                              <1> 	;/////////////////////////////////////////////COEF 5////////////////////////////////////////////////////////////////
   157                              <1> 	cmp [coef_%1], word 0						;if coefficient is 0
   158                              <1> 	je CalculateFunctionY_skip_%1				;then skip
   159                              <1> 
   160                              <1> 	xor CX,CX									;Clear counter (necessary?)
   161                              <1> 	mov CX, %1									;Counter to multiply x n-times (x^n)
   162                              <1> 
   163                              <1> 	cmp CX, 0									;Have we reached x^n?
   164                              <1> 	je CalculateFunctionY_%1_coef_mult			;Then go to coefficient
   165                              <1> 	fld qword [graph_current_x]					;grab x									F-Stack:1
   166                              <1> 	sub CX, 1									;one more close to x^n
   167                              <1> 
   168                              <1> 	CalculateFunctionY_%1_loop:					;Multiply by x until x^n
   169                              <1> 		cmp CX, 0								;Have we reached x^n?
   170                              <1> 		je CalculateFunctionY_%1_coef_mult		;Then go to coefficient
   171                              <1> 		fmul qword [graph_current_x]			;ST(0)*x
   172                              <1> 		sub CX, 1								;one more close to x^n
   173                              <1> 		jmp CalculateFunctionY_%1_loop
   174                              <1> 
   175                              <1> 	CalculateFunctionY_%1_coef_mult:
   176                              <1> 	fimul word [coef_%1]						;At this point, we have |coef|*x^n
   177                              <1> 
   178                              <1> 	cmp [coef_%1_sign], byte 0x0				;Its positive?
   179                              <1> 	je CalculateFunctionY_x_%1_positive			;Skip sign change
   180                              <1> 	fchs
   181                              <1> 
   182                              <1> 	CalculateFunctionY_x_%1_positive:
   183                              <1> 	;Now we have coef*x^n
   184                              <1> 	fld qword [graph_result_y]					;load result by previous coefficient	F-Stack:2
   185                              <1> 	faddp										;Add them								F-Stack:1
   186                              <1> 	fstp qword [graph_result_y]					;Store it								F-Stack:0
   187                              <1> 	CalculateFunctionY_skip_%1:
   188                              <1> %endmacro
   189                              <1> 
   190                              <1> 
   191                              <1> %macro MACRO_FIND_DERIV_X_VALUE_OF_COEF 1
   192                              <1> 	;/////////////////////////////////////////////COEF 5////////////////////////////////////////////////////////////////
   193                              <1> 	cmp [coef_%1_d], word 0						;if coefficient is 0
   194                              <1> 	je CalculateDerivativeY_skip_%1				;then skip
   195                              <1> 
   196                              <1> 	xor CX,CX									;Clear counter (necessary?)
   197                              <1> 	mov CX, %1									;Counter to multiply x n-times (x^n)
   198                              <1> 	sub CX, 1									;Because of derivative
   199                              <1> 
   200                              <1> 	cmp CX, 0									;Have we reached x^n?
   201                              <1> 	je CalculateDerivativeY_%1_coef_mult		;Then go to coefficient
   202                              <1> 	fld qword [graph_current_x]					;grab x									F-Stack:1
   203                              <1> 	sub CX, 1									;one more close to x^n
   204                              <1> 
   205                              <1> 	CalculateDerivativeY_%1_loop:				;Multiply by x until x^n
   206                              <1> 		cmp CX, 0								;Have we reached x^n?
   207                              <1> 		je CalculateDerivativeY_%1_coef_mult	;Then go to coefficient
   208                              <1> 		fmul qword [graph_current_x]			;ST(0)*x
   209                              <1> 		sub CX, 1								;one more close to x^n
   210                              <1> 		jmp CalculateDerivativeY_%1_loop
   211                              <1> 
   212                              <1> 	CalculateDerivativeY_%1_coef_mult:
   213                              <1> 	fimul word [coef_%1_d]						;At this point, we have |coef|*x^n
   214                              <1> 
   215                              <1> 	cmp [coef_%1_sign], byte 0x0				;Its positive?
   216                              <1> 	je CalculateDerivativeY_x_%1_positive		;Skip sign change
   217                              <1> 	fchs
   218                              <1> 
   219                              <1> 	CalculateDerivativeY_x_%1_positive:
   220                              <1> 	;Now we have coef*x^n
   221                              <1> 	fld qword [graph_result_y_d]				;load result by previous coefficient	F-Stack:2
   222                              <1> 	faddp										;Add them								F-Stack:1
   223                              <1> 	fstp qword [graph_result_y_d]				;Store it								F-Stack:0
   224                              <1> 	CalculateDerivativeY_skip_%1:
   225                              <1> %endmacro
   226                              <1> 
   227                              <1> 
   228                              <1> 
   229                              <1> %macro MACRO_FIND_INTEG_X_VALUE_OF_COEF 1
   230                              <1> 	;/////////////////////////////////////////////COEF 5////////////////////////////////////////////////////////////////
   231                              <1> 	cmp [coef_%1_i_num], word 0					;if coefficient is 0
   232                              <1> 	je CalculateIntegralY_skip_%1				;then skip
   233                              <1> 
   234                              <1> 	xor CX,CX									;Clear counter (necessary?)
   235                              <1> 	mov CX, %1									;Counter to multiply x n-times (x^n)
   236                              <1> 	add CX, 1									;Because of integral
   237                              <1> 
   238                              <1> 	cmp CX, 0									;Have we reached x^n?
   239                              <1> 	je CalculateIntegralY_%1_coef_mult			;Then go to coefficient
   240                              <1> 	fld qword [graph_current_x]					;grab x									F-Stack:1
   241                              <1> 	sub CX, 1									;one more close to x^n
   242                              <1> 
   243                              <1> 	CalculateIntegralY_%1_loop:					;Multiply by x until x^n
   244                              <1> 		cmp CX, 0								;Have we reached x^n?
   245                              <1> 		je CalculateIntegralY_%1_coef_mult		;Then go to coefficient
   246                              <1> 		fmul qword [graph_current_x]			;ST(0)*x
   247                              <1> 		sub CX, 1								;one more close to x^n
   248                              <1> 		jmp CalculateIntegralY_%1_loop
   249                              <1> 
   250                              <1> 	CalculateIntegralY_%1_coef_mult:
   251                              <1> 	fimul word [coef_%1_i_num]
   252                              <1> 	fidiv word [coef_%1_i_den]					;At this point, we have |coef|*x^n
   253                              <1> 
   254                              <1> 	cmp [coef_%1_sign], byte 0x0				;Its positive?
   255                              <1> 	je CalculateIntegralY_x_%1_positive			;Skip sign change
   256                              <1> 	fchs
   257                              <1> 
   258                              <1> 	CalculateIntegralY_x_%1_positive:
   259                              <1> 	;Now we have coef*x^n
   260                              <1> 	fld qword [graph_result_y_i]				;load result by previous coefficient	F-Stack:2
   261                              <1> 	faddp										;Add them								F-Stack:1
   262                              <1> 	fstp qword [graph_result_y_i]				;Store it								F-Stack:0
   263                              <1> 	CalculateIntegralY_skip_%1:
   264                              <1> %endmacro
   265                              <1> 
