    10                              <1> %macro MACRO_INPUT_CHAR_NO_ECO 0
    11                              <1> 	mov AH, 0x8		;User input without echo
    12                              <1> 	int 0x21		;DOS Function Dispatcher
    13                              <1> %endmacro
    14                              <1> 
    15                              <1> 
    16                              <1> %macro MACRO_PRINT_CHAR 1
    17                              <1> 	xor DX, DX
    18                              <1> 	mov AH, 0x6 			; Print String
    19                              <1> 	mov DL, %1	; Start address of message
    20                              <1> 	int 0x21
    21                              <1> %endmacro
    22                              <1> 
    23                              <1> 
    24                              <1> %macro MACRO_PRINT_STRING 1
    25                              <1> 	mov AH, 0x9 			; Print String
    26                              <1> 	mov DX, %1	; Start address of message
    27                              <1> 	int 0x21
    28                              <1> %endmacro
    29                              <1> 
    30                              <1> 
    31                              <1> %macro MACRO_PARSE_STRING_BUFFER 1
    32                              <1> 	mov SI, %1		;Parameter for Parse String
    33                              <1> 	call ParseString
    34                              <1> %endmacro
    35                              <1> 
