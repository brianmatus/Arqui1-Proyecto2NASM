   267                              <1> ;ONE TIME USE
   268                              <1> %macro MACRO_ASK_X0 0
   269                              <1> 	GraphFunction_enter_xo:
   270                              <1> 		MACRO_PRINT_STRING str_enter_xo				;Promt to enter xo
   271                              <1> 		call ReadUntilLN							;Read input
   272                              <1> 		MACRO_PRINT_STRING text_ln_r
   273                              <1> 		MACRO_PARSE_STRING_BUFFER inStrBuf			;Parse the number
   274                              <1> 
   275                              <1> 		cmp CX, word 0x1							;If no error
   276                              <1> 		jne GraphFunction_xo_correct				;then continue
   277                              <1> 		MACRO_PRINT_STRING input_error_2			;print user error
   278                              <1> 		jmp GraphFunction_enter_xo					;retry
   279                              <1> 
   280                              <1> 	GraphFunction_xo_correct:
   281                              <1> 	cmp BX, word 0x0								;if negative
   282                              <1> 	je GraphFunction_xo_positive
   283                              <1> 	neg AX											;invert sign
   284                              <1> 	GraphFunction_xo_positive:
   285                              <1> 	mov [graph_xo], AX								;store it
   286                              <1> 
   287                              <1> %endmacro
   288                              <1> 
   289                              <1> 
   290                              <1> ;ONE TIME USE
   291                              <1> %macro MACRO_ASK_XF 0
   292                              <1> 	GraphFunction_enter_xf:
   293                              <1> 		MACRO_PRINT_STRING str_enter_xf			;Promt to enter xf
   294                              <1> 		call ReadUntilLN						;Read input
   295                              <1> 		MACRO_PRINT_STRING text_ln_r
   296                              <1> 		MACRO_PARSE_STRING_BUFFER inStrBuf		;Parse the number
   297                              <1> 
   298                              <1> 		cmp CX, word 0x1						;If no error
   299                              <1> 		jne GraphFunction_xf_correct			;then continue
   300                              <1> 		MACRO_PRINT_STRING input_error_2		;print user error
   301                              <1> 		jmp GraphFunction_enter_xo				;retry to xo in case of mind change
   302                              <1> 
   303                              <1> 	GraphFunction_xf_correct:
   304                              <1> 	cmp BX, word 0x0							;if negative
   305                              <1> 	je GraphFunction_xf_positive
   306                              <1> 	neg AX										;invert sign
   307                              <1> 	GraphFunction_xf_positive:
   308                              <1> 	mov [graph_xf], AX							;store it
   309                              <1> 	cmp AX, [graph_xo]							;If Xf-Xo
   310                              <1> 	jg GraphFunction_interval_correct			;continue
   311                              <1> 	MACRO_PRINT_STRING input_error_3			;else, tell user
   312                              <1> 	jmp GraphFunction_enter_xo					;and try again
   313                              <1> 
   314                              <1> 	GraphFunction_interval_correct:
   315                              <1> 
   316                              <1> %endmacro
   317                              <1> 
   318                              <1> 
   319                              <1> ;ONE TIME USE
   320                              <1> %macro MACRO_ASK_Y_RANGE 0
   321                              <1> 	GraphFunction_enter_y_range:
   322                              <1> 		MACRO_PRINT_STRING str_enter_y_range	;Promt to enter Y range
   323                              <1> 		call ReadUntilLN						;Read input
   324                              <1> 		MACRO_PRINT_STRING text_ln_r
   325                              <1> 		MACRO_PARSE_STRING_BUFFER inStrBuf		;Parse the number
   326                              <1> 
   327                              <1> 		cmp CX, word 0x1						;If no error
   328                              <1> 		jne GraphFunction_y_range_correct		;then continue
   329                              <1> 		MACRO_PRINT_STRING input_error_2		;print user error
   330                              <1> 		jmp GraphFunction_enter_y_range			;retry
   331                              <1> 
   332                              <1> 		GraphFunction_y_range_correct:
   333                              <1> 		cmp BX, word 0x0						;Y interval is not entered with -
   334                              <1> 		je GraphFunction_y_range_positive
   335                              <1> 		MACRO_PRINT_STRING input_error_3		;print user error
   336                              <1> 		jmp GraphFunction_enter_y_range
   337                              <1> 
   338                              <1> 	GraphFunction_y_range_positive:
   339                              <1> 	mov [graph_y_size], AX
   340                              <1> %endmacro
