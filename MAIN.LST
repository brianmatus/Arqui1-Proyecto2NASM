   491                                  ParseString:	;[SI] as pointer,   returns: AX: result BX: sign  CX:return code
   492 0000016C 31C0                        xor ax, ax ;
   493 0000016E 31DB                        xor bx, bx ;
   494 00000170 31C9                        xor cx, cx ;
   495                                  
   496 00000172 BF0A00                      mov di, 10 ; set the base to 10
   497                                  
   498                                  	;TODO checar primer caracter por un signo
   499                                  
   500 00000175 8A1C                    	mov bl, [SI] ; load the current character into bl
   501                                  
   502 00000177 81FB2B00                	cmp bx, '+'
   503 0000017B 7504                    	jne ParseString_check_minus
   504 0000017D 46                      	inc si ; move to the next character
   505 0000017E E90D00                  	jmp ParseString_is_positive
   506                                  
   507                                  	ParseString_check_minus:
   508 00000181 81FB2D00                	cmp bx, '-'
   509 00000185 7507                    	jne ParseString_is_positive
   510 00000187 680100                  	push 0x1	;Flag as negative
   511 0000018A 46                      	inc si 		; move to the next character
   512                                  
   513 0000018B E90300                  	jmp parse_loop
   514                                  
   515                                  	ParseString_is_positive:
   516 0000018E 680000                  	push 0x0	;Flag as possitive
   517                                  
   518                                  	parse_loop:
   519 00000191 8A1C                        mov bl, [SI] ; load the current character into al
   520 00000193 46                          inc si ; move to the next character
   521                                  
   522 00000194 80FB00                      cmp bl, 0x0 		;have we reached the end of the number?
   523 00000197 7416                        je  parse_done
   524                                  
   525 00000199 81FB3000                	cmp bx, '0'			;Is this not a number char? (lower half)
   526 0000019D 7C15                    	jl parse_error
   527 0000019F 81FB3900                	cmp bx, '9'			;Is this not a number char? (upper half)
   528 000001A3 7F0F                    	jg parse_error
   529                                  
   530 000001A5 81EB3000                    sub bx, '0' 		; subtract the ASCII value of '0' to get the actual numeric value
   531 000001A9 F7E7                        mul di		 		; multiply the current result by the base (10)
   532 000001AB 01D8                        add ax, bx 			; add the digit to the result
   533                                  
   534 000001AD EBE2                        jmp parse_loop ; continue parsing the next character
   535                                  
   536                                  	parse_done:
   537 000001AF B90000                  	mov CX, 0			;Exit code 0 for success, 1 for input error
   538 000001B2 5B                      	pop BX
   539                                  ;	cmp BX, 0
   540                                  ;	je ParseString_not_negative_result
   541                                  ;	neg AX
   542                                  ;	ParseString_not_negative_result
   543 000001B3 C3                          ret
   544                                  
   545                                      parse_error:
   546 000001B4 B90100                      mov CX, 1
   547                                  ;    pop BX
   548 000001B7 6681C402000000          	add esp, 2
   549 000001BE C3                          ret
