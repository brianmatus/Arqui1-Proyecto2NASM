     2                                  ;Ahora, sólo dios sabe xD
     3                                  %include "code/macros.asm"
     1                              <1> %macro CLEARSCREEN 0
     2                              <1> 	;Video BIOS
     3                              <1> 	mov AH, 0x0		;Set video mode
     4                              <1> 	mov AL, 0x12	;640x480 16 color graphics (VGA)
     5                              <1> 	int 0x10
     6                              <1> %endmacro
