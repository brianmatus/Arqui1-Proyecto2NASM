  1646                                  MaxCommonDivisor:					;STACK has both numbers
  1647 00001AAA 31D2                    	xor DX, DX
  1648 00001AAC 678B442402              	mov AX, [ESP+2]					;x  of x/y
  1649 00001AB1 678B5C2404              	mov BX, [ESP+4]					;y of x/y
  1650                                  	;remainder will be stored in DX by default
  1651 00001AB6 39D8                    	cmp AX, BX						;Swap AX if BX is bigger
  1652 00001AB8 7D01                    	jge MaxCommonDivisor_no_swap
  1653 00001ABA 93                      	xchg AX, BX
  1654                                  	MaxCommonDivisor_no_swap:
  1655                                  	MaxCommonDivisor_loop:
  1656 00001ABB 83FB00                  		cmp BX, 0					;Until no remainder:
  1657 00001ABE 740A                    		je MaxCommonDivisor_exit
  1658 00001AC0 31D2                    		xor DX, DX					;clean for division
  1659 00001AC2 F7F3                    		div BX
  1660 00001AC4 89D8                    		mov AX, BX					;x=y
  1661 00001AC6 89D3                    		mov BX, DX					;y=remainder
  1662 00001AC8 EBF1                    		jmp MaxCommonDivisor_loop	;repeat
  1663                                  	MaxCommonDivisor_exit:
  1664 00001ACA C3                      	ret
