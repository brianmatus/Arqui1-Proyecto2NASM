   681 00000257 31C0                        xor ax, ax 	; Clean needed registers
   682 00000259 31DB                        xor bx, bx 	;
   683 0000025B 31C9                        xor cx, cx 	;
   684                                  
   685 0000025D BF0A00                      mov di, 10 ; set the base to 10
   686                                  
   687                                  	;TODO checar primer caracter por un signo
   688                                  
   689 00000260 8A1C                    	mov bl, [SI] ; load the current character into bl
   690                                  
   691 00000262 81FB2B00                	cmp bx, '+'
   692 00000266 7504                    	jne ParseString_check_minus
   693 00000268 46                      	inc si ; move to the next character
   694 00000269 E90D00                  	jmp ParseString_is_positive
   695                                  
   696                                  	ParseString_check_minus:
   697 0000026C 81FB2D00                	cmp bx, '-'
   698 00000270 7507                    	jne ParseString_is_positive
   699 00000272 680100                  	push 0x1	;Flag as negative
   700 00000275 46                      	inc si 		; move to the next character
   701                                  
   702 00000276 E90300                  	jmp parse_loop
   703                                  
   704                                  	ParseString_is_positive:
   705 00000279 680000                  	push 0x0	;Flag as possitive
   706                                  
   707                                  	parse_loop:
   708 0000027C 8A1C                        mov bl, [SI] ; load the current character into al
   709 0000027E 46                          inc si ; move to the next character
   710                                  
   711 0000027F 80FB00                      cmp bl, 0x0 		;have we reached the end of the number?
   712 00000282 7416                        je  parse_done
   713                                  
   714 00000284 81FB3000                	cmp bx, '0'			;Is this not a number char? (lower half)
   715 00000288 7C15                    	jl parse_error
   716 0000028A 81FB3900                	cmp bx, '9'			;Is this not a number char? (upper half)
   717 0000028E 7F0F                    	jg parse_error
   718                                  
   719 00000290 81EB3000                    sub bx, '0' 		; subtract the ASCII value of '0' to get the actual numeric value
   720 00000294 F7E7                        mul di		 		; multiply the current result by the base (10)
   721 00000296 01D8                        add ax, bx 			; add the digit to the result
   722                                  
   723 00000298 EBE2                        jmp parse_loop ; continue parsing the next character
   724                                  
   725                                  	parse_done:
   726 0000029A B90000                  	mov CX, 0			;Exit code 0 for success, 1 for input error
   727 0000029D 5B                      	pop BX
   728                                  ;	cmp BX, 0
   729                                  ;	je ParseString_not_negative_result
   730                                  ;	neg AX
   731                                  ;	ParseString_not_negative_result
   732 0000029E C3                          ret
   733                                  
   734                                      parse_error:
   735 0000029F B90100                      mov CX, 1
   736                                  ;    pop BX
   737 000002A2 6681C402000000          	add esp, 2
   738 000002A9 C3                          ret
