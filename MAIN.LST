   770                                  	ParseString_check_minus:
   771 00000E2D 83FB2D                  	cmp bx, '-'
   772 00000E30 7505                    	jne ParseString_is_positive
   773 00000E32 6A01                    	push 0x1	;Flag as negative
   774 00000E34 46                      	inc si 		; move to the next character
   775                                  
   776 00000E35 EB02                    	jmp parse_loop
   777                                  
   778                                  	ParseString_is_positive:
   779 00000E37 6A00                    	push 0x0	;Flag as possitive
   780                                  
   781                                  	parse_loop:
   782 00000E39 8A1C                        mov bl, [SI] ; load the current character into al
   783 00000E3B 46                          inc si ; move to the next character
   784                                  
   785 00000E3C 80FB00                      cmp bl, 0x0 		;have we reached the end of the number?
   786 00000E3F 7413                        je  parse_done
   787                                  
   788 00000E41 83FB30                  	cmp bx, '0'			;Is this not a number char? (lower half)
   789 00000E44 7C13                    	jl parse_error
   790 00000E46 83FB39                  	cmp bx, '9'			;Is this not a number char? (upper half)
   791 00000E49 7F0E                    	jg parse_error
   792                                  
   793 00000E4B 83EB30                      sub bx, '0' 		; subtract the ASCII value of '0' to get the actual numeric value
   794 00000E4E F7E7                        mul di		 		; multiply the current result by the base (10)
   795 00000E50 01D8                        add ax, bx 			; add the digit to the result
   796                                  
   797 00000E52 EBE5                        jmp parse_loop ; continue parsing the next character
   798                                  
   799                                  	parse_done:
   800 00000E54 B90000                  	mov CX, 0			;Exit code 0 for success, 1 for input error
   801 00000E57 5B                      	pop BX
