     1                              <1> %macro CLEARSCREEN 0
     2                              <1> 	;Video BIOS
     3                              <1> 	mov AH, 0x0		;Set video mode
     4                              <1> 	mov AL, 0x12	;640x480 16 color graphics (VGA)
     5                              <1> 	int 0x10
     6                              <1> %endmacro
     7                              <1> 
     8                              <1> %macro MACRO_EXIT_APPLICATION 0
     9                              <1> 	mov AH, 0x4C
    10                              <1> 	mov AL, 0x0
    11                              <1> 	int 0x21
    12                              <1> %endmacro
    13                              <1> 
    14                              <1> %macro MACRO_INPUT_CHAR_NO_ECO 0
    15                              <1> 	mov AH, 0x8		;User input without echo
    16                              <1> 	int 0x21		;DOS Function Dispatcher
    17                              <1> %endmacro
    18                              <1> 
