   675 00000254 31C0                        xor ax, ax 	; Clean needed registers
   676 00000256 31DB                        xor bx, bx 	;
   677 00000258 31C9                        xor cx, cx 	;
   678                                  
   679 0000025A BF0A00                      mov di, 10 ; set the base to 10
   680                                  
   681                                  	;TODO checar primer caracter por un signo
   682                                  
   683 0000025D 8A1C                    	mov bl, [SI] ; load the current character into bl
   684                                  
   685 0000025F 81FB2B00                	cmp bx, '+'
   686 00000263 7504                    	jne ParseString_check_minus
   687 00000265 46                      	inc si ; move to the next character
   688 00000266 E90D00                  	jmp ParseString_is_positive
   689                                  
   690                                  	ParseString_check_minus:
   691 00000269 81FB2D00                	cmp bx, '-'
   692 0000026D 7507                    	jne ParseString_is_positive
   693 0000026F 680100                  	push 0x1	;Flag as negative
   694 00000272 46                      	inc si 		; move to the next character
   695                                  
   696 00000273 E90300                  	jmp parse_loop
   697                                  
   698                                  	ParseString_is_positive:
   699 00000276 680000                  	push 0x0	;Flag as possitive
   700                                  
   701                                  	parse_loop:
   702 00000279 8A1C                        mov bl, [SI] ; load the current character into al
   703 0000027B 46                          inc si ; move to the next character
   704                                  
   705 0000027C 80FB00                      cmp bl, 0x0 		;have we reached the end of the number?
   706 0000027F 7416                        je  parse_done
   707                                  
   708 00000281 81FB3000                	cmp bx, '0'			;Is this not a number char? (lower half)
   709 00000285 7C15                    	jl parse_error
   710 00000287 81FB3900                	cmp bx, '9'			;Is this not a number char? (upper half)
   711 0000028B 7F0F                    	jg parse_error
   712                                  
   713 0000028D 81EB3000                    sub bx, '0' 		; subtract the ASCII value of '0' to get the actual numeric value
   714 00000291 F7E7                        mul di		 		; multiply the current result by the base (10)
   715 00000293 01D8                        add ax, bx 			; add the digit to the result
   716                                  
   717 00000295 EBE2                        jmp parse_loop ; continue parsing the next character
   718                                  
   719                                  	parse_done:
   720 00000297 B90000                  	mov CX, 0			;Exit code 0 for success, 1 for input error
   721 0000029A 5B                      	pop BX
