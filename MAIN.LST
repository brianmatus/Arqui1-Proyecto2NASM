   129                              <1> %macro MACRO_UPDATE_DERIVATIVE_COEF 1
   130                              <1> 	xor DX, DX				;Clean up
   131                              <1> 	mov AX, [coef_%1]		;x
   132                              <1> 	mov BX, %1				;y
   133                              <1> 	mul BX					;x = xy
   134                              <1> 	mov [coef_%1_d], AX		;Store it
   135                              <1> %endmacro
   136                              <1> 
   137                              <1> %macro MACRO_UPDATE_INTEGRAL_COEFFICIENT 1
   138                              <1> 
   139                              <1> 	push word [coef_%1]		;Numerator
   140                              <1> 	push %1+1				;Divisor
   141                              <1> 	call MaxCommonDivisor
   142                              <1> 	add ESP, 4				;Clean stack
   143                              <1> 
   144                              <1> 	;Now that MCD is calculated, divide both numbers by it
   145                              <1> 	mov BX, AX				;Denominator
   146                              <1> 	xor DX, DX				;Clean upper part of numerator
   147                              <1> 	mov AX, [coef_%1]		;Numerator
   148                              <1> 	div BX
   149                              <1> 	mov [coef_%1_i_num], AX	;Save integral numerator
   150                              <1> 
   151                              <1> 	;BX already has max common divisor as denominator
   152                              <1> 	xor DX, DX				;Clean upper part of numerator
   153                              <1> 	mov AX, %1+1			;Numerator
   154                              <1> 	div BX
   155                              <1> 	mov [coef_%1_i_den], AX	;Save integral denominator
   156                              <1> 
   157                              <1> %endmacro
   158                              <1> 
   159                              <1> %macro MACRO_FIND_FUNC_X_VALUE_OF_COEF 1
   160                              <1> 	;/////////////////////////////////////////////COEF 5////////////////////////////////////////////////////////////////
   161                              <1> 	cmp [coef_%1], word 0						;if coefficient is 0
   162                              <1> 	je CalculateFunctionY_skip_%1				;then skip
   163                              <1> 
   164                              <1> 	xor CX,CX									;Clear counter (necessary?)
   165                              <1> 	mov CX, %1									;Counter to multiply x n-times (x^n)
   166                              <1> 
   167                              <1> 	cmp CX, 0									;Have we reached x^n?
   168                              <1> 	je CalculateFunctionY_%1_coef_mult			;Then go to coefficient
   169                              <1> 	fld qword [graph_current_x]					;grab x									F-Stack:1
   170                              <1> 	sub CX, 1									;one more close to x^n
   171                              <1> 
   172                              <1> 	CalculateFunctionY_%1_loop:					;Multiply by x until x^n
   173                              <1> 		cmp CX, 0								;Have we reached x^n?
   174                              <1> 		je CalculateFunctionY_%1_coef_mult		;Then go to coefficient
   175                              <1> 		fmul qword [graph_current_x]			;ST(0)*x
   176                              <1> 		sub CX, 1								;one more close to x^n
   177                              <1> 		jmp CalculateFunctionY_%1_loop
   178                              <1> 
   179                              <1> 	CalculateFunctionY_%1_coef_mult:
   180                              <1> 	fimul word [coef_%1]						;At this point, we have |coef|*x^n
   181                              <1> 
   182                              <1> 	cmp [coef_%1_sign], byte 0x0				;Its positive?
   183                              <1> 	je CalculateFunctionY_x_%1_positive			;Skip sign change
   184                              <1> 	fchs
   185                              <1> 
   186                              <1> 	CalculateFunctionY_x_%1_positive:
   187                              <1> 	;Now we have coef*x^n
   188                              <1> 	fld qword [graph_result_y]					;load result by previous coefficient	F-Stack:2
   189                              <1> 	faddp										;Add them								F-Stack:1
   190                              <1> 	fstp qword [graph_result_y]					;Store it								F-Stack:0
   191                              <1> 	CalculateFunctionY_skip_%1:
   192                              <1> %endmacro
   193                              <1> 
   194                              <1> 
   195                              <1> %macro MACRO_FIND_DERIV_X_VALUE_OF_COEF 1
   196                              <1> 	;/////////////////////////////////////////////COEF 5////////////////////////////////////////////////////////////////
   197                              <1> 	cmp [coef_%1_d], word 0						;if coefficient is 0
   198                              <1> 	je CalculateDerivativeY_skip_%1				;then skip
   199                              <1> 
   200                              <1> 	xor CX,CX									;Clear counter (necessary?)
   201                              <1> 	mov CX, %1									;Counter to multiply x n-times (x^n)
   202                              <1> 	sub CX, 1									;Because of derivative
   203                              <1> 
   204                              <1> 	cmp CX, 0									;Have we reached x^n?
   205                              <1> 	je CalculateDerivativeY_%1_coef_mult		;Then go to coefficient
   206                              <1> 	fld qword [graph_current_x]					;grab x									F-Stack:1
   207                              <1> 	sub CX, 1									;one more close to x^n
   208                              <1> 
   209                              <1> 	CalculateDerivativeY_%1_loop:				;Multiply by x until x^n
   210                              <1> 		cmp CX, 0								;Have we reached x^n?
   211                              <1> 		je CalculateDerivativeY_%1_coef_mult	;Then go to coefficient
   212                              <1> 		fmul qword [graph_current_x]			;ST(0)*x
   213                              <1> 		sub CX, 1								;one more close to x^n
   214                              <1> 		jmp CalculateDerivativeY_%1_loop
   215                              <1> 
   216                              <1> 	CalculateDerivativeY_%1_coef_mult:
   217                              <1> 	fimul word [coef_%1_d]						;At this point, we have |coef|*x^n
   218                              <1> 
   219                              <1> 	cmp [coef_%1_sign], byte 0x0				;Its positive?
   220                              <1> 	je CalculateDerivativeY_x_%1_positive		;Skip sign change
   221                              <1> 	fchs
   222                              <1> 
   223                              <1> 	CalculateDerivativeY_x_%1_positive:
   224                              <1> 	;Now we have coef*x^n
   225                              <1> 	fld qword [graph_result_y_d]				;load result by previous coefficient	F-Stack:2
   226                              <1> 	faddp										;Add them								F-Stack:1
   227                              <1> 	fstp qword [graph_result_y_d]				;Store it								F-Stack:0
   228                              <1> 	CalculateDerivativeY_skip_%1:
   229                              <1> %endmacro
   230                              <1> 
   231                              <1> 
   232                              <1> 
   233                              <1> %macro MACRO_FIND_INTEG_X_VALUE_OF_COEF 1
   234                              <1> 	;/////////////////////////////////////////////COEF 5////////////////////////////////////////////////////////////////
   235                              <1> 	cmp [coef_%1_i_num], word 0					;if coefficient is 0
   236                              <1> 	je CalculateIntegralY_skip_%1				;then skip
   237                              <1> 
   238                              <1> 	xor CX,CX									;Clear counter (necessary?)
   239                              <1> 	mov CX, %1									;Counter to multiply x n-times (x^n)
   240                              <1> 	add CX, 1									;Because of integral
   241                              <1> 
   242                              <1> 	cmp CX, 0									;Have we reached x^n?
   243                              <1> 	je CalculateIntegralY_%1_coef_mult			;Then go to coefficient
   244                              <1> 	fld qword [graph_current_x]					;grab x									F-Stack:1
   245                              <1> 	sub CX, 1									;one more close to x^n
   246                              <1> 
   247                              <1> 	CalculateIntegralY_%1_loop:					;Multiply by x until x^n
   248                              <1> 		cmp CX, 0								;Have we reached x^n?
   249                              <1> 		je CalculateIntegralY_%1_coef_mult		;Then go to coefficient
   250                              <1> 		fmul qword [graph_current_x]			;ST(0)*x
   251                              <1> 		sub CX, 1								;one more close to x^n
   252                              <1> 		jmp CalculateIntegralY_%1_loop
   253                              <1> 
   254                              <1> 	CalculateIntegralY_%1_coef_mult:
   255                              <1> 	fimul word [coef_%1_i_num]
   256                              <1> 	fidiv word [coef_%1_i_den]					;At this point, we have |coef|*x^n
   257                              <1> 
   258                              <1> 	cmp [coef_%1_sign], byte 0x0				;Its positive?
   259                              <1> 	je CalculateIntegralY_x_%1_positive			;Skip sign change
   260                              <1> 	fchs
   261                              <1> 
   262                              <1> 	CalculateIntegralY_x_%1_positive:
   263                              <1> 	;Now we have coef*x^n
   264                              <1> 	fld qword [graph_result_y_i]				;load result by previous coefficient	F-Stack:2
   265                              <1> 	faddp										;Add them								F-Stack:1
   266                              <1> 	fstp qword [graph_result_y_i]				;Store it								F-Stack:0
   267                              <1> 	CalculateIntegralY_skip_%1:
   268                              <1> %endmacro
   269                              <1> 
